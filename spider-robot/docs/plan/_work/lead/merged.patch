+    assert await _until(lambda: robot.mode == "standing" and robot._height_reached(), 5.0)
+    await run_turn(pipe)
+    assert await _until(lambda: robot.move is not None, 2.0)
+    assert isinstance(robot.move, Move) and robot.move.trace
