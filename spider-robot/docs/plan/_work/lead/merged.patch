new file mode 100644
index 0000000..10124e3
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/adapters/ask_rpc.py
@@ -0,0 +1,31 @@
+"""Vision and hard questions, answered by the brain over MQTT.
+
+AskReply has only text, so nothing that comes back through here can move the robot, and the Pi
+holds no cloud keys and no model ports are opened on the server.
+"""
+
+from __future__ import annotations
+
+from spider_common.protocol import MAX_ASK_CHARS, AskReply, AskRequest
+
+from ..rpc import RpcClient
+
+
+class RpcAsk:
+    def __init__(self, rpc: RpcClient, timeout_s: float, need_image: bool) -> None:
+        self.rpc, self.timeout_s, self.need_image = rpc, timeout_s, need_image
+
+    async def _call(self, question: str, trace: str) -> str:
+        request = AskRequest(trace=trace, text=question[:MAX_ASK_CHARS], need_image=self.need_image,
+                             deadline_s=min(self.timeout_s, 120.0))
+        raw = await self.rpc.call("ask", trace, request.model_dump_json(), self.timeout_s)
+        reply = AskReply.model_validate_json(raw)
+        if not reply.ok or not reply.text.strip():
+            raise RuntimeError(reply.error or "no answer")
+        return reply.text
+
+    async def ask(self, question: str, trace: str) -> str:
+        return await self._call(question, trace)
+
+    async def answer(self, question: str, trace: str) -> str:
+        return await self._call(question, trace)
diff --git a/spider-robot/voice/src/spider_voice/adapters/router_ollama.py b/spider-robot/voice/src/spider_voice/adapters/router_ollama.py
new file mode 100644
index 0000000..c895725
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/adapters/router_ollama.py
@@ -0,0 +1,67 @@
+"""LFM2.5-350M (or any model) through Ollama's chat API: one JSON decision, streamed.
+
+The act is reported the moment it is readable, so motion can start before the reply is finished.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import re
+from collections.abc import Callable
+
+import httpx
+
+from ..config import RouterCfg
+from ..grammar import ROUTER_ACTS
+from ..interfaces import RouterDecision
+from ..routing import NUM_CTX, NUM_PREDICT, SCHEMA, SYSTEM_PROMPT, TEMPERATURE, parse_decision
+
+_EARLY_ACT = re.compile(r'"act"\s*:\s*"([a-z]+)"')
+
+
+class OllamaRouter:
+    def __init__(self, cfg: RouterCfg, http: httpx.AsyncClient | None = None) -> None:
+        self.cfg = cfg
+        self.http = http or httpx.AsyncClient(timeout=cfg.timeout_s)
+
+    def payload(self, transcript: str) -> dict:
+        return {
+            "model": self.cfg.model,
+            "stream": True,
+            "format": SCHEMA,
+            "keep_alive": -1,
+            "options": {
+                "temperature": TEMPERATURE,
+                "top_k": 50,
+                "repeat_penalty": 1.05,
+                "num_predict": NUM_PREDICT,
+                "num_ctx": NUM_CTX,
+                "num_thread": 3,  # the three non-reserved cores
+            },
+            "messages": [
+                {"role": "system", "content": SYSTEM_PROMPT},
+                {"role": "user", "content": transcript},
+            ],
+        }
+
+    async def _stream(self, transcript: str, on_act: Callable[[str], None] | None) -> str:
+        buffer, fired = "", False
+        url = f"{self.cfg.url.rstrip('/')}/api/chat"
+        async with self.http.stream("POST", url, json=self.payload(transcript)) as resp:
+            resp.raise_for_status()
+            async for line in resp.aiter_lines():
+                if not line:
+                    continue
+                buffer += json.loads(line).get("message", {}).get("content", "")
+                if not fired and (m := _EARLY_ACT.search(buffer)) and m.group(1) in ROUTER_ACTS:
+                    fired = True
+                    if on_act is not None:
+                        on_act(m.group(1))
+        return buffer
+
+    async def route(
+        self, transcript: str, on_act: Callable[[str], None] | None = None
+    ) -> RouterDecision:
+        raw = await asyncio.wait_for(self._stream(transcript, on_act), self.cfg.timeout_s)
+        return parse_decision(raw)
diff --git a/spider-robot/voice/src/spider_voice/adapters/stt_chain.py b/spider-robot/voice/src/spider_voice/adapters/stt_chain.py
new file mode 100644
index 0000000..ccdb1b4
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/adapters/stt_chain.py
@@ -0,0 +1,25 @@
+"""Server first, local if the server cannot answer. Selected with stt.primary: whisper_server.
+
+Off by default. Decision 3 keeps Whisper tiny on the Pi as the primary; bench B-V1 decides whether
+this swap is justified. The breaker in RpcStt keeps a dead server from costing a timeout each time.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from ..interfaces import STT, Transcript
+
+log = logging.getLogger(__name__)
+
+
+class ServerFirstSTT:
+    def __init__(self, server: STT, local: STT) -> None:
+        self.server, self.local = server, local
+
+    async def transcribe(self, pcm16: bytes, sample_rate: int) -> Transcript:
+        try:
+            return await self.server.transcribe(pcm16, sample_rate)
+        except Exception as exc:
+            log.info("server STT unavailable, using local: %r", exc)
+        return await self.local.transcribe(pcm16, sample_rate)
diff --git a/spider-robot/voice/src/spider_voice/adapters/stt_rpc.py b/spider-robot/voice/src/spider_voice/adapters/stt_rpc.py
new file mode 100644
index 0000000..1a8b304
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/adapters/stt_rpc.py
@@ -0,0 +1,48 @@
+"""The bigger Whisper on the server, for utterances the local model was unsure about.
+
+It travels over the broker, which is on the Pi, so a publish succeeds even when the server is gone.
+Without the breaker every unsure utterance would wait out the full timeout.
+"""
+
+from __future__ import annotations
+
+import base64
+import math
+import time
+from collections.abc import Callable
+
+from spider_common.obs import new_trace
+from spider_common.protocol import SttReply, SttRequest
+
+from ..interfaces import Transcript
+from ..rpc import RpcClient
+
+
+class ServerUnavailable(RuntimeError):
+    pass
+
+
+class RpcStt:
+    def __init__(
+        self, rpc: RpcClient, timeout_s: float, retry_after_s: float = 30.0, prompt: str = "",
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self.rpc, self.timeout_s, self.retry_after_s = rpc, timeout_s, retry_after_s
+        self.prompt, self.clock = prompt, clock
+        self._closed_until = -math.inf
+
+    async def transcribe(self, pcm16: bytes, sample_rate: int) -> Transcript:
+        if self.clock() < self._closed_until:
+            raise ServerUnavailable("server STT recently timed out; skipping it")
+        trace = new_trace()
+        request = SttRequest(trace=trace, audio_b64=base64.b64encode(pcm16).decode("ascii"),
+                             rate=sample_rate, prompt=self.prompt)
+        try:
+            raw = await self.rpc.call("stt", trace, request.model_dump_json(), self.timeout_s)
+        except TimeoutError:
+            self._closed_until = self.clock() + self.retry_after_s
+            raise
+        reply = SttReply.model_validate_json(raw)
+        if not reply.ok:
+            raise RuntimeError(reply.error or "server STT failed")
+        return Transcript(reply.text, avg_logprob=math.log(max(reply.confidence, 1e-6)))
diff --git a/spider-robot/voice/src/spider_voice/adapters/stt_whisper.py b/spider-robot/voice/src/spider_voice/adapters/stt_whisper.py
new file mode 100644
index 0000000..16ef344
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/adapters/stt_whisper.py
@@ -0,0 +1,60 @@
+"""faster-whisper (CTranslate2) on the Pi. Runs in worker threads; never blocks the event loop."""
+
+from __future__ import annotations
+
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+
+import numpy as np
+
+from ..config import WhisperLocalCfg
+from ..interfaces import Transcript
+
+
+class TranscribeTimeout(TimeoutError):
+    """The caller gave up, but the thread is still using a worker until `running` is done."""
+
+    def __init__(self, running: asyncio.Future) -> None:
+        super().__init__("whisper timed out")
+        self.running = running
+
+
+class WhisperLocalSTT:
+    def __init__(self, cfg: WhisperLocalCfg, model=None) -> None:
+        self.cfg = cfg
+        # Loaded here, once, before anyone speaks: the first Stop must not pay the load time.
+        self._model = model if model is not None else self._create()
+        self._pool = ThreadPoolExecutor(max_workers=cfg.workers, thread_name_prefix="stt")
+
+    def _create(self):
+        from faster_whisper import WhisperModel
+
+        c = self.cfg
+        return WhisperModel(c.model, device="cpu", compute_type=c.compute_type,
+                            cpu_threads=c.cpu_threads, num_workers=c.workers)
+
+    def _run(self, pcm16: bytes) -> Transcript:
+        audio = np.frombuffer(pcm16, dtype="<i2").astype(np.float32) / 32768.0
+        segments, _info = self._model.transcribe(
+            audio, language=self.cfg.language, beam_size=1, vad_filter=False,
+            condition_on_previous_text=False, without_timestamps=True,
+            initial_prompt=self.cfg.prompt or None,
+        )
+        parts = list(segments)
+        if not parts:
+            return Transcript("", avg_logprob=-10.0, no_speech_prob=1.0)
+        return Transcript(
+            text=" ".join(s.text.strip() for s in parts).strip(),
+            avg_logprob=sum(s.avg_logprob for s in parts) / len(parts),
+            no_speech_prob=max(s.no_speech_prob for s in parts),
+        )
+
+    async def transcribe(self, pcm16: bytes, sample_rate: int) -> Transcript:
+        if sample_rate != 16000:
+            raise ValueError("whisper needs 16 kHz audio")
+        loop = asyncio.get_running_loop()
+        work = loop.run_in_executor(self._pool, self._run, pcm16)
+        done, _ = await asyncio.wait({work}, timeout=self.cfg.timeout_s)
+        if not done:
+            raise TranscribeTimeout(work)
+        return work.result()
diff --git a/spider-robot/voice/src/spider_voice/adapters/tts_espeak.py b/spider-robot/voice/src/spider_voice/adapters/tts_espeak.py
