+    ticks(robot, lidar, clock, 0.1)
+    assert robot.gait.height > cfg.geometry.sit_height_m + 0.003
+    robot.handle(Posture(posture="relax", ts=WALL))
+    assert robot.mode == "sitting" and not servos.relaxed
+
+
+def test_latch_write_failure_raises_an_error_event(cfg, tmp_path):
+    blocker = tmp_path / "file"
+    blocker.write_text("x")
+    latch = EStopLatch(blocker / "sub" / "estop")  # the parent is a file: mkdir must fail
+    robot, _, lidar, _, brain, clock = rig(cfg, latch=latch)
+    robot.handle(EStop(ts=WALL))
+    latch.wait()
+    assert latch.write_failed
+    ticks(robot, lidar, clock, 0.1)
+    assert any(e["kind"] == "error" and "latch" in e["detail"] for e in events(brain))
+
+
+def test_gil_interval_is_set_from_config():
+    previous = sys.getswitchinterval()
+    try:
+        set_gil_interval(RtCfg(gil_switch_ms=2.0))
+        assert sys.getswitchinterval() == pytest.approx(0.002)
+    finally:
+        sys.setswitchinterval(previous)
+
+
+class _SpyServos(FakeServoBank):
+    log: list[str] = []
+
+    def relax(self) -> None:
+        _SpyServos.log.append("relax")
+        super().relax()
+
+
+async def _run_briefly(cfg, monkeypatch):
+    hub = InMemoryHub()
+    _SpyServos.log = []
+    original = Robot.tick
+
+    def spy_tick(self, dt):
+        _SpyServos.log.append("tick")
+        original(self, dt)
+
+    monkeypatch.setattr(main_module, "FakeServoBank", _SpyServos)
+    monkeypatch.setattr(Robot, "tick", spy_tick)
+    monkeypatch.setattr(main_module, "build_link", lambda c: hub.endpoint([Topics(c.robot_id).cmd]))
+    await main_module.run(cfg, sim=True, jitter_seconds=0.06)
+
+
+async def test_startup_relaxes_servos_before_the_first_tick(cfg, monkeypatch):
+    await _run_briefly(cfg, monkeypatch)
+    assert _SpyServos.log[0] == "relax"
+    assert "tick" in _SpyServos.log
+
+
+async def test_startup_under_a_latched_estop_does_not_touch_the_servos(cfg, monkeypatch, tmp_path):
+    path = tmp_path / "estop"
+    path.write_text("latched")
+    cfg.estop_latch_path = str(path)
+    await _run_briefly(cfg, monkeypatch)
+    assert "relax" not in _SpyServos.log
+    assert "tick" in _SpyServos.log
+    assert path.exists()
diff --git a/spider-robot/body/tests/test_sysmon.py b/spider-robot/body/tests/test_sysmon.py
new file mode 100644
index 0000000..94d69cc
--- /dev/null
+++ b/spider-robot/body/tests/test_sysmon.py
@@ -0,0 +1,71 @@
+import json
+
+import pytest
+
+from spider_body.sysmon import (
+    SOFT_TEMP_NOW,
+    THROTTLED_NOW,
+    UNDERVOLT_EVER,
+    UNDERVOLT_NOW,
+    assess,
+    available_mem_mb,
+    parse_failed_units,
+    parse_tailscale_path,
+    read_int,
+)
+
+
+def test_healthy():
+    assert assess(0, 55.0, 2000.0, 9000.0) == ("ok", "")
+
+
+@pytest.mark.parametrize(
+    ("flags", "temp", "level"),
+    [
+        (UNDERVOLT_NOW, 50.0, "down"),
+        (THROTTLED_NOW, 50.0, "down"),
+        (0, 80.0, "down"),
+        (SOFT_TEMP_NOW, 50.0, "degraded"),
+        (UNDERVOLT_EVER, 50.0, "degraded"),
+        (0, 76.0, "degraded"),
+        (0, None, "degraded"),
+    ],
+)
+def test_levels(flags, temp, level):
+    assert assess(flags, temp, 2000.0, 9000.0)[0] == level
+
+
+def test_low_memory_and_disk_are_reported():
+    assert "MB free" in assess(0, 50.0, 100.0, 9000.0)[1]
+    assert "disk" in assess(0, 50.0, 2000.0, 100.0)[1]
+
+
+def test_read_int_handles_hex_and_missing(tmp_path):
+    f = tmp_path / "v"
+    f.write_text("0x50005\n")
+    assert read_int(f, 16) == 0x50005
+    assert read_int(tmp_path / "missing") is None
+
+
+def test_available_memory_parsing(tmp_path):
+    f = tmp_path / "meminfo"
+    f.write_text("MemTotal: 4000000 kB\nMemAvailable: 2048000 kB\n")
+    assert available_mem_mb(f) == 2000.0
+    assert available_mem_mb(tmp_path / "missing") is None
+
+
+def _status(**node):
+    return json.dumps({"Peer": {"k": {"HostName": "server", "Online": True, **node}}})
+
+
+def test_tailscale_paths():
+    assert parse_tailscale_path(_status(CurAddr="1.2.3.4:41641"), "server") == "direct"
+    assert parse_tailscale_path(_status(Relay="tok", CurAddr=""), "server") == "relay"
+    assert parse_tailscale_path(_status(Online=False), "server") == "none"
+    assert parse_tailscale_path(_status(), "other") == "none"
+    assert parse_tailscale_path(None, "server") is None
+
+
+def test_failed_units_keep_only_ours():
+    text = "spider-voice.service loaded failed failed x\nsnapd.service loaded failed failed y\n"
+    assert parse_failed_units(text) == ["spider-voice.service"]
