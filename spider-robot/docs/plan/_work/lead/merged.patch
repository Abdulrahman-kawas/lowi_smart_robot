+#!/usr/bin/env bash
+# Required before first use of the worker: e-mail at 80% of a small monthly budget.
+#   ACCOUNT_ID=123456789012 EMAIL=you@example.com LIMIT_USD=20 bash budget_alarm.sh
+set -euo pipefail
+: "${ACCOUNT_ID:?set ACCOUNT_ID}" "${EMAIL:?set EMAIL}"
+LIMIT_USD="${LIMIT_USD:-20}"
+aws budgets create-budget --account-id "$ACCOUNT_ID" \
+  --budget "{\"BudgetName\":\"spider-worker\",\"BudgetLimit\":{\"Amount\":\"$LIMIT_USD\",\"Unit\":\"USD\"},\"TimeUnit\":\"MONTHLY\",\"BudgetType\":\"COST\"}" \
+  --notifications-with-subscribers "[{\"Notification\":{\"NotificationType\":\"ACTUAL\",\"ComparisonOperator\":\"GREATER_THAN\",\"Threshold\":80,\"ThresholdType\":\"PERCENTAGE\"},\"Subscribers\":[{\"SubscriptionType\":\"EMAIL\",\"Address\":\"$EMAIL\"}]}]"
diff --git a/spider-robot/infra/aws/worker/run_job.sh b/spider-robot/infra/aws/worker/run_job.sh
new file mode 100644
index 0000000..a1eb3f6
--- /dev/null
+++ b/spider-robot/infra/aws/worker/run_job.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# Runs one mapping job on the worker: recording in, point cloud map out.
+#   /opt/spider/run_job.sh <job id>
+set -euo pipefail
+JOB="$1"
+[[ "$JOB" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "bad job id"; exit 2; }
+DATA=/data
+[[ -s "$DATA/$JOB.bag" ]] || { echo "no recording uploaded"; exit 2; }
+docker run --rm -v "$DATA:/data" spider-slam:noetic /run_slam.sh "$JOB"
+[[ -s "$DATA/$JOB.pcd" ]] || { echo "SLAM produced no map"; exit 3; }
diff --git a/spider-robot/infra/aws/worker/run_slam.sh b/spider-robot/infra/aws/worker/run_slam.sh
new file mode 100644
index 0000000..1c719b1
--- /dev/null
+++ b/spider-robot/infra/aws/worker/run_slam.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+# Inside the container: replay the bag through Point-LIO and keep the accumulated map.
+set -eo pipefail
+JOB="$1"
+source /opt/ros/noetic/setup.bash
+source /catkin_ws/devel/setup.bash
+roslaunch point_lio_unilidar mapping_unilidar_l2.launch rviz:=false &
+LAUNCH=$!
+sleep 5
+rosbag play --clock -r 1.0 "/data/$JOB.bag"
+sleep 5
+kill -INT "$LAUNCH"
+wait "$LAUNCH" || true
+cp /catkin_ws/src/point_lio_unilidar/PCD/scans.pcd "/data/$JOB.pcd"
