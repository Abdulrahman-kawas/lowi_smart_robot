+
+[Service]
+User=spider
+SupplementaryGroups=audio
+WorkingDirectory=/opt/spider/spider-robot/voice
+ExecStart=/opt/spider/spider-robot/voice/.venv/bin/spider-voice --config /etc/spider/voice.yaml
+Restart=always
+RestartSec=2
+CPUAffinity=1 2 3
+Nice=0
+MemoryMax=900M
+OOMScoreAdjust=300
