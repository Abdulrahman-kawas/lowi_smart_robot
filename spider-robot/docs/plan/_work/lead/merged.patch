@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# The real-time gate (test RT1 in the plan). Run on the Pi, with the robot on its stand.
+#   sudo bash bench_jitter.sh 3600
+# Loads cores 1-3 as hard as the voice stack can, then reports control-loop timing on core 0.
+# Run it twice: once with a copy of robot.yaml that has "rt: {enabled: false}" as the second
+# argument, once with the shipped file. The gate is judged on the shipped setting.
+set -euo pipefail
+SECONDS_TO_RUN="${1:-3600}"
+CONFIG="${2:-/etc/spider/robot.yaml}"
+BODY=/opt/spider/spider-robot/body/.venv/bin/spider-body
+command -v stress-ng >/dev/null || { echo "apt install stress-ng rt-tests"; exit 2; }
+
+systemctl stop spider-body
+trap 'systemctl start spider-body' EXIT
+
+taskset -c 1-3 stress-ng --cpu 3 --vm 1 --vm-bytes 2G --io 1 --timeout "${SECONDS_TO_RUN}s" &
+systemd-run --pipe --wait -p CPUAffinity=0 -p User=spider -p LimitRTPRIO=60 \
+  -p LimitMEMLOCK=infinity -p "AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK" \
+  "$BODY" --config "$CONFIG" --jitter-seconds "$SECONDS_TO_RUN" --text-logs
+wait
+echo "Pass: late p99.9 <= 5 ms, max <= 18 ms, overruns <= 1 per 10000 ticks, rt_ok true."
diff --git a/spider-robot/infra/pi/deploy.sh b/spider-robot/infra/pi/deploy.sh
new file mode 100644
index 0000000..5936de4
--- /dev/null
+++ b/spider-robot/infra/pi/deploy.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+# Updates a running robot, run on the Pi from an unpacked copy of spider-robot:
+#   bash infra/pi/deploy.sh
+# Refuses unless the robot is sitting or relaxed. Keeps the previous release and goes back to it
+# by itself if a service does not come up. The gateway restarts before voice and body.
+set -euo pipefail
+SR="$(cd "$(dirname "$0")/../.." && pwd)"
+ROOT=/opt/spider
+LINK="$ROOT/spider-robot"
+RELEASES="$ROOT/releases"
+ROBOT_ID="${ROBOT_ID:-spider-01}"
+PYTHON_VERSION="${PYTHON_VERSION:-3.12}"
+SERVICES=(spider-gateway spider-voice spider-body spider-camera spider-recorder spider-sysmon spider-button)
+SECRET="$(sudo cat /etc/spider/secrets/spider-console.mqtt)"
+
+mode() {  # the gateway's retained status, one message, 3 s at most; no answer means unknown
+  mosquitto_sub -h 127.0.0.1 -p 1883 -u spider-console -P "$SECRET" -C 1 -W 3 \
+    -t "spider/$ROBOT_ID/gw/status" \
+    | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["mode"] if d["online"] else "offline")'
+}
+
+current_mode="$(mode || echo unknown)"
+case "$current_mode" in
+  relaxed|sitting) ;;
+  *) echo "refusing: the robot is '$current_mode'. Sit it down first."; exit 1 ;;
+esac
+
+sudo install -d -o "$USER" "$RELEASES"
+if [[ -d "$LINK" && ! -L "$LINK" ]]; then   # first deploy after setup_pi.sh
+  sudo mv "$LINK" "$RELEASES/initial"
+  sudo ln -s "$RELEASES/initial" "$LINK"
+fi
+previous="$(readlink -f "$LINK")"
+release="$RELEASES/$(date +%Y%m%d-%H%M%S)"
+rsync -a --exclude .venv --exclude __pycache__ --exclude docs "$SR/" "$release/"
+export UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/opt/spider/python
+for pkg in body gateway; do
+  (cd "$release/$pkg" && uv sync --frozen --no-dev --extra gpio --python "$PYTHON_VERSION")
+done
+(cd "$release/voice" && uv sync --frozen --no-dev --extra pi --python "$PYTHON_VERSION")
+sudo chown -R spider:spider "$release"
+
+activate() {
+  sudo ln -sfn "$1" "$LINK"
+  sudo systemctl restart "${SERVICES[@]}"
+  sleep 8
+  for svc in "${SERVICES[@]}"; do
+    systemctl is-active --quiet "$svc" || return 1
+  done
+}
+
+if activate "$release"; then
+  echo "deployed $release (previous: $previous)"
+  ls -1dt "$RELEASES"/* | tail -n +4 | xargs -r sudo rm -rf   # keep three
+else
+  echo "a service failed; going back to $previous"
+  activate "$previous"
+  exit 1
+fi
