index 0000000..155e378
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/grammar.py
@@ -0,0 +1,106 @@
+"""The closed-vocabulary motion grammar and the wake-word gate.
+
+Common commands are matched on the transcript in microseconds, without a model. The same lexicon
+checks anything the LLM router proposes: the router may only choose a motion whose words the owner
+actually said, so a hallucination or an injected instruction cannot invent a walk.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .text import tokens, word_matches
+
+MOTION_ACTS = frozenset({"forward", "back", "left", "right"})
+ROUTER_ACTS = ("forward", "back", "left", "right", "stop", "look", "none")
+
+LEXICON: dict[str, tuple[str, ...]] = {
+    "forward": ("قدام", "امام", "لقدام", "للامام", "امشي", "تقدم", "forward", "ahead"),
+    "back": ("ورا", "وراء", "لورا", "خلف", "للخلف", "ارجع", "back", "backward"),
+    "left": ("يسار", "شمال", "لليسار", "للشمال", "left"),
+    "right": ("يمين", "لليمين", "right"),
+    "stand": ("قوم", "انهض", "stand"),
+    "sit": ("اقعد", "اجلس", "sit"),
+    "look": ("شوف", "انظر", "بص", "look", "see"),
+}
+NEGATIONS = frozenset(tokens("لا ما مش مو بلاش dont not"))
+CANNED_SAY = {
+    "forward": "حاضر، لقدام",
+    "back": "حاضر، لورا",
+    "left": "حاضر، يسار",
+    "right": "حاضر، يمين",
+    "stand": "حاضر",
+    "sit": "حاضر",
+    "look": "لحظة أشوف",
+}
+
+
+@dataclass(frozen=True)
+class GrammarHit:
+    act: str
+    say: str
+
+
+def _lexicon_tokens(entries: tuple[str, ...]) -> tuple[str, ...]:
+    return tuple(t for entry in entries for t in tokens(entry))
+
+
+_NORMALISED = {act: _lexicon_tokens(words) for act, words in LEXICON.items()}
+
+
+def acts_in(transcript: str) -> set[str]:
+    """Every act whose words appear in the transcript."""
+    words = tokens(transcript)
+    return {
+        act for act, targets in _NORMALISED.items()
+        if any(word_matches(word, t) for word in words for t in targets)
+    }
+
+
+def has_negation(transcript: str) -> bool:
+    return any(word in NEGATIONS for word in tokens(transcript))
+
+
+def match(transcript: str, max_words: int = 6) -> GrammarHit | None:
+    """A hit only for a short utterance naming exactly one act; anything else goes to the router."""
+    if len(tokens(transcript)) > max_words or has_negation(transcript):
+        return None
+    found = acts_in(transcript)
+    if len(found) != 1:
+        return None
+    act = next(iter(found))
+    return GrammarHit(act, CANNED_SAY[act])
+
+
+class WakeGate:
+    """Motion needs the wake word, or a recent command. Stop words never pass through here."""
+
+    def __init__(self, words: tuple[str, ...], window_s: float, enabled: bool = True) -> None:
+        self.words = tuple(t for w in words for t in tokens(w))
+        self.window_s = window_s
+        self.enabled = enabled
+        self._open_until = -1.0
+
+    def heard_wake_word(self, transcript: str) -> bool:
+        return any(word_matches(w, t) for w in tokens(transcript) for t in self.words)
+
+    def accept(self, transcript: str, now: float) -> bool:
+        if not self.enabled:
+            return True
+        if self.heard_wake_word(transcript):
+            self._open_until = now + self.window_s
+            return True
+        return now < self._open_until
+
+    def extend(self, now: float) -> None:
+        if self._open_until >= now:
+            self._open_until = now + self.window_s
+
+    def remove_from(self, transcript: str) -> str:
+        """Drop the wake word so that 'يا لوي امشي قدام' routes the same as 'امشي قدام'."""
+        words = transcript.split()
+        keep = [not any(word_matches(w, t) for t in self.words) for w in tokens(transcript)]
+        for i in range(1, len(keep)):
+            if not keep[i] and tokens(words[i - 1]) == ["يا"]:  # the vocative goes with the name
+                keep[i - 1] = False
+        return " ".join(w for w, k in zip(words, keep, strict=False) if k)
diff --git a/spider-robot/voice/src/spider_voice/gwclient.py b/spider-robot/voice/src/spider_voice/gwclient.py
new file mode 100644
index 0000000..117cf05
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/gwclient.py
@@ -0,0 +1,105 @@
+"""The voice loop's connection to the command gateway. Voice never talks to the body directly."""
+
+from __future__ import annotations
+
+import asyncio
+import itertools
+import logging
+import time
+import uuid
+from collections.abc import Callable
+
+from spider_common.link import Link
+from spider_common.protocol import (
+    AskReply,
+    Command,
+    EStop,
+    Heartbeat,
+    Move,
+    RobotEvent,
+    RobotState,
+    Stop,
+    Topics,
+)
+
+from .rpc import RpcClient
+
+log = logging.getLogger(__name__)
+STATE_FRESH_S = 1.0
+_MOTION_ENDED = frozenset({"obstacle_stop", "tilt", "fallen", "preempted", "estop"})
+
+
+class GatewayClient:
+    SOURCE = "voice"
+
+    def __init__(
+        self, link: Link, robot_id: str, clock: Callable[[], float] = time.monotonic
+    ) -> None:
+        self.link = link
+        self.clock = clock
+        self.rpc = RpcClient(link, robot_id)
+        self._motion_until = 0.0
+        self.topics = Topics(robot_id)
+        self._cmd_topic = self.topics.request(self.SOURCE)
+        self._event_topic = self.topics.source_event(self.SOURCE)
+        self.session = uuid.uuid4().hex[:12]
+        self._seq = itertools.count(1)
+        self.state: RobotState | None = None
+        self.state_rx: float | None = None
+        self.last_event: RobotEvent | None = None
+
+    @staticmethod
+    def subscriptions(robot_id: str) -> list[str]:
+        t = Topics(robot_id)
+        return [t.source_event(GatewayClient.SOURCE), t.state, t.rpc_reply("ask", "voice"),
+                t.rpc_reply("stt", "voice")]
+
+    @property
+    def walking(self) -> bool:
+        """Moving as far as this process knows: a Move it just sent, or recent telemetry."""
+        now = self.clock()
+        if now < self._motion_until:
+            return True
+        if self.state is None or self.state_rx is None or now - self.state_rx > STATE_FRESH_S:
+            return False
+        return self.state.mode == "walking"
+
+    def send(self, cmd: Command, trace: str = "", qos: int = 1) -> int:
+        """Publish one command. Returns its seq, or -1 when the broker is unreachable."""
+        seq = next(self._seq)
+        out = cmd.model_copy(update={"seq": seq, "ts": time.time(), "session": self.session,
+                                     "trace": trace})
+        if isinstance(cmd, Move):
+            self._motion_until = self.clock() + cmd.duration_s
+        elif isinstance(cmd, (Stop, EStop)):
+            self._motion_until = 0.0
+        return seq if self.link.publish(self._cmd_topic, out.model_dump_json(), qos=qos) else -1
+
+    def stop(self, trace: str = "") -> int:
+        return self.send(Stop(), trace)
+
+    def estop(self, trace: str = "") -> int:
+        return self.send(EStop(), trace)
+
+    async def heartbeat_loop(self, hz: float) -> None:
+        while True:
+            self.link.publish(self._cmd_topic, Heartbeat(ts=time.time()).model_dump_json())
+            await asyncio.sleep(1.0 / hz)
+
+    async def run(self) -> None:
+        async for msg in self.link.messages():
+            try:
+                if msg.topic == self.topics.state:
+                    self.state = RobotState.model_validate_json(msg.payload)
+                    self.state_rx = self.clock()
+                elif msg.topic == self._event_topic:
+                    self._on_event(RobotEvent.model_validate_json(msg.payload))
+                elif msg.topic in self.rpc.reply_topics():
+                    self.rpc.on_reply(AskReply.model_validate_json(msg.payload).trace, msg.payload)
+            except Exception:
+                log.exception("bad message on %s", msg.topic)
+
+    def _on_event(self, ev: RobotEvent) -> None:
+        self.last_event = ev
+        if ev.kind in _MOTION_ENDED:
+            self._motion_until = 0.0
diff --git a/spider-robot/voice/src/spider_voice/interfaces.py b/spider-robot/voice/src/spider_voice/interfaces.py
new file mode 100644
index 0000000..d32ac6e
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/interfaces.py
@@ -0,0 +1,66 @@
+"""The swappable parts. Moving a service to another machine is a config change.
+
+Everything async here is cancellable and must honour its own timeout; nothing blocks the event
+loop. Vendor SDKs live only in spider_voice.adapters and are imported inside the adapter.
+"""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator, Callable
+from dataclasses import dataclass
+from typing import Protocol
+
+
+@dataclass(frozen=True)
+class Transcript:
+    text: str
+    avg_logprob: float = 0.0
+    no_speech_prob: float = 0.0
+
+
+@dataclass(frozen=True)
+class RouterDecision:
+    act: str
+    say: str
+
+
+class STT(Protocol):
+    async def transcribe(self, pcm16: bytes, sample_rate: int) -> Transcript: ...
+
+
+class TTS(Protocol):
+    sample_rate: int
+
+    def synthesize(self, text: str) -> AsyncIterator[bytes]:
+        """Raw 16-bit mono PCM chunks, as soon as each is ready."""
+        ...
+
+
+class Router(Protocol):
+    async def route(
+        self, transcript: str, on_act: Callable[[str], None] | None = None
+    ) -> RouterDecision:
+        """Decide. on_act, if given, is called once as soon as the act is readable in the stream."""
+        ...
+
+
+class Vision(Protocol):
+    async def ask(self, question: str, trace: str) -> str:
+        """The worker takes the photo itself, so no image crosses this interface."""
+        ...
+
+
+class Answerer(Protocol):
+    """Slow path for a harder question. The answer is only ever spoken."""
+
+    async def answer(self, question: str, trace: str) -> str: ...
+
+
+class AudioOut(Protocol):
+    async def play(self, chunks: AsyncIterator[bytes], sample_rate: int) -> float | None:
+        """Play to the end. Returns the seconds until the first sample, or None if cut off."""
+        ...
+
+    def cut(self) -> None:
+        """Stop the sound now (barge-in)."""
+        ...
diff --git a/spider-robot/voice/src/spider_voice/main.py b/spider-robot/voice/src/spider_voice/main.py
new file mode 100644
index 0000000..540dca2
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/main.py
@@ -0,0 +1,129 @@
+"""spider-voice entry point: microphone, pipeline, gateway connection, health."""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import logging
+import signal
+from pathlib import Path
+
+from spider_common.link import MqttLink, MqttSettings
+from spider_common.obs import setup_logging
+from spider_common.protocol import HealthReport, Topics, VoiceTurn
+
+from . import registry
+from .adapters.vad_webrtc import WebRtcVad
+from .audio import AplayOutput, ArecordCapture, frame_rms, is_speech_frame
+from .config import VoiceConfig, load_config
+from .gwclient import GatewayClient
+from .pipeline import VoicePipeline
+
+log = logging.getLogger("spider_voice")
+HEALTH_PERIOD_S = 5.0
+STT_TIMEOUTS_DEGRADED = 3
+
+
+def build_link(cfg: VoiceConfig) -> MqttLink:
+    t = Topics(cfg.robot_id)
+    will = HealthReport(robot_id=cfg.robot_id, service="voice", level="down", detail="lost")
+    m = cfg.mqtt
+    password = Path(m.password_file).read_text("utf-8").strip() if m.password_file else None
+    return MqttLink(
+        MqttSettings(host=m.host, port=m.port, client_id=m.client_id, tls=m.tls,
+                     username=m.username, password=password, reconnect_max_s=m.reconnect_max_s),
+        subscriptions=GatewayClient.subscriptions(cfg.robot_id),
+        will=(t.health("voice"), will.model_dump_json().encode()),
+        will_retain=True,
+    )
+
+
+def health_report(cfg: VoiceConfig, pipeline: VoicePipeline, connected: bool) -> HealthReport:
+    level = "ok" if connected and pipeline.ready else "degraded"
+    detail = "" if pipeline.ready else "starting"
+    if pipeline.stt_timeouts >= STT_TIMEOUTS_DEGRADED:
+        level, detail = "degraded", "speech recognition keeps timing out"
+    metrics = {f"stt_{k}": v for k, v in pipeline.stt_hist.snapshot().items()}
+    metrics |= {f"route_{k}": v for k, v in pipeline.route_hist.snapshot().items()}
+    metrics |= {"turns": float(pipeline.turns), "failures": float(pipeline.failures),
+                "dropped": float(pipeline.dropped),
+                "stt_timeouts": float(pipeline.stt_timeouts)}
+    return HealthReport(robot_id=cfg.robot_id, service="voice", level=level, detail=detail,
+                        metrics=metrics)
+
+
+async def _capture(cfg: VoiceConfig, pipeline: VoicePipeline, vad: WebRtcVad) -> None:
+    a = cfg.audio
+    await pipeline.prepare()  # models in memory and phrases rendered before anyone is listened to
+    log.info("spider-voice ready")
+    capture = ArecordCapture(a.capture_device, a.sample_rate, a.frame_ms)
+    async for frame in capture.frames():
+        rms = frame_rms(frame)
+        pipeline.on_frame(frame, is_speech_frame(vad.is_speech(frame), rms, a.min_rms_dbfs), rms)
+
+
+async def _health(link: MqttLink, cfg: VoiceConfig, pipeline: VoicePipeline) -> None:
+    topic = Topics(cfg.robot_id).health("voice")
+    while True:
+        report = health_report(cfg, pipeline, link.connected.is_set())
+        link.publish(topic, report.model_dump_json(), qos=1, retain=True)
+        await asyncio.sleep(HEALTH_PERIOD_S)
+
+
+async def run(cfg: VoiceConfig) -> None:
+    link = build_link(cfg)
+    gateway = GatewayClient(link, cfg.robot_id)
+    topics = Topics(cfg.robot_id)
+
+    def publish_turn(turn: VoiceTurn) -> None:
+        link.publish(topics.voice_turn, turn.model_dump_json())
+
+    pipeline = VoicePipeline(
+        cfg,
+        stt=registry.build_stt(cfg, gateway.rpc),
+        tts=registry.build_tts(cfg),
+        router=registry.build_router(cfg),
+        gateway=gateway,
+        audio=AplayOutput(cfg.audio.playback_device),
+        tts_fallback=registry.build_tts_fallback(cfg),
+        stt_escalate=registry.build_stt_escalation(cfg, gateway.rpc),
+        vision=registry.build_vision(cfg, gateway.rpc),
+        answerers=registry.build_answerers(cfg, gateway.rpc),
+        publish_turn=publish_turn,
+    )
+    vad = WebRtcVad(cfg.audio.vad_aggressiveness, cfg.audio.sample_rate)
+    await link.start()
+    stop = asyncio.Event()
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        loop.add_signal_handler(sig, stop.set)
+    tasks = [
+        asyncio.create_task(gateway.run(), name="link"),
+        asyncio.create_task(gateway.heartbeat_loop(cfg.heartbeat_hz), name="heartbeat"),
+        asyncio.create_task(_capture(cfg, pipeline, vad), name="capture"),
+        asyncio.create_task(_health(link, cfg, pipeline), name="health"),
+    ]
+    log.info("spider-voice running")
+    waiter = asyncio.create_task(stop.wait())
+    done, _ = await asyncio.wait([waiter, *tasks], return_when=asyncio.FIRST_COMPLETED)
+    for task in done:
+        if task is not waiter and task.exception():
+            log.error("task %s crashed: %r", task.get_name(), task.exception())
+    for task in tasks:
+        task.cancel()
+    await asyncio.gather(*tasks, return_exceptions=True)
+    await link.stop()
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="spider-voice")
+    parser.add_argument("--config", default="/etc/spider/voice.yaml")
+    parser.add_argument("--log-level", default="INFO")
+    args = parser.parse_args(argv)
+    setup_logging(args.log_level, service="spider-voice")
+    asyncio.run(run(load_config(args.config)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
