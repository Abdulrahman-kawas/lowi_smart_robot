+    assert pin_cpu(RtCfg(cpu=0), sys) is True
+    assert enable_fifo(RtCfg(priority=50), sys, lock=lambda: None) is True
+    assert sys.calls == [("affinity", {0}), ("fifo", 1, 50)]
