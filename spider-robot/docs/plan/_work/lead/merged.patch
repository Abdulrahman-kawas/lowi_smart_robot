+    stt.result = Transcript("وقف", -0.2, 0.1)
+    started = time.monotonic()
+    await run_turn(pipe)
+    assert await _until(lambda: robot.move is None, 1.0)
+    assert time.monotonic() - started < 0.5  # software path only: STT latency is a separate budget
