diff --git a/spider-robot/infra/pi/files/nftables-spider.conf b/spider-robot/infra/pi/files/nftables-spider.conf
new file mode 100644
index 0000000..ed55601
--- /dev/null
+++ b/spider-robot/infra/pi/files/nftables-spider.conf
@@ -0,0 +1,14 @@
+#!/usr/sbin/nft -f
+# /etc/nftables.d/spider.conf. Only these ports are restricted; everything else is unchanged.
+table inet spider {
+  chain input {
+    type filter hook input priority 0; policy accept;
+    tcp dport 8883 iifname != "tailscale0" drop
+    tcp dport 1883 iifname != "lo" drop
+    tcp dport 11434 iifname != "lo" drop
+    # SSH: the tailnet, or the home LAN for recovery when Tailscale is down.
+    tcp dport 22 iifname != { "lo", "tailscale0" } ip saddr != 192.168.0.0/24 drop
+    # The LiDAR port accepts only the LiDAR.
+    udp dport 6201 ip saddr != 192.168.1.62 drop
+  }
+}
