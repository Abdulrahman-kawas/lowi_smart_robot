diff --git a/spider-robot/brain/src/spider_brain/observe.py b/spider-robot/brain/src/spider_brain/observe.py
new file mode 100644
index 0000000..4f72056
--- /dev/null
+++ b/spider-robot/brain/src/spider_brain/observe.py
@@ -0,0 +1,106 @@
+"""Latency summaries from voice turns, and alerts from service health reports."""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from collections import Counter, deque
+from pathlib import Path
+
+from spider_common.protocol import HealthReport, VoiceTurn
+
+from .supervision.events import EventBus
+
+log = logging.getLogger(__name__)
+
+MAX_TRACES = 2000
+MAX_FILE_BYTES = 10 * 1024 * 1024
+ALERT_COOLDOWN_S = 300.0
+_THROTTLE_NOW = 0x7  # under-voltage, frequency capped, throttled, at this moment
+
+
+def percentile(values: list[float], p: float) -> float:
+    ordered = sorted(values)
+    return ordered[min(len(ordered) - 1, int(p * len(ordered)))]
+
+
+class TraceStore:
+    def __init__(self, path: Path) -> None:
+        self.path = path
+        self.items: deque[VoiceTurn] = deque(maxlen=MAX_TRACES)
+
+    def add(self, payload: bytes) -> dict:
+        trace = VoiceTurn.model_validate_json(payload)
+        self.items.append(trace)
+        self._append(trace)
+        return self.summary()
+
+    def _append(self, trace: VoiceTurn) -> None:
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            if self.path.exists() and self.path.stat().st_size > MAX_FILE_BYTES:
+                self.path.replace(self.path.with_suffix(".1"))
+            with self.path.open("a", encoding="utf-8") as f:
+                f.write(trace.model_dump_json() + "\n")
+        except OSError as exc:  # observability must never break the brain
+            log.warning("could not store a trace: %s", exc)
+
+    def summary(self) -> dict:
+        stages: dict[str, list[float]] = {}
+        for trace in self.items:
+            for name, ms in (("stt", trace.stt_ms), ("router", trace.route_ms),
+                             ("first_audio", trace.tts_first_ms), ("total", trace.total_ms)):
+                if ms is not None:
+                    stages.setdefault(name, []).append(ms)
+        return {
+            "stages": {
+                name: {"n": len(v), "p50": round(percentile(v, 0.5), 1),
+                       "p95": round(percentile(v, 0.95), 1)}
+                for name, v in sorted(stages.items())
+            },
+            "paths": dict(Counter(t.route for t in self.items)),
+        }
+
+
+def assess(r: HealthReport) -> list[str]:
+    """The conditions worth waking someone for. Everything else is on the dashboard."""
+    problems = []
+    m, who = r.metrics, r.service
+    if r.level == "down" and who != "system":  # a dead service reports this through its last will
+        problems.append(f"{who}: is down {r.detail}".rstrip())
+    if m.get("stt_timeouts", 0.0) >= 3:
+        problems.append(f"{who}: speech recognition keeps timing out")
+    if m.get("temp_c", 0.0) >= 80.0:
+        problems.append(f"{who}: CPU at {m['temp_c']:.0f} C")
+    if int(m.get("throttled_flags", 0)) & _THROTTLE_NOW:
+        problems.append(f"{who}: throttled or under-voltage ({int(m['throttled_flags']):#x})")
+    if m.get("mem_available_mb", 1e9) < 300:
+        problems.append(f"{who}: only {m['mem_available_mb']:.0f} MB memory free")
+    if m.get("disk_free_mb", 1e9) < 1024:
+        problems.append(f"{who}: only {m['disk_free_mb']:.0f} MB disk free")
+    if r.info.get("failed_units"):
+        problems.append(f"{who}: failed units {r.info['failed_units']}")
+    if r.info.get("tailscale_path") == "none":
+        problems.append(f"{who}: no path to the peer on Tailscale")
+    return problems
+
+
+class HealthMonitor:
+    def __init__(self, bus: EventBus, clock=time.monotonic) -> None:
+        self.bus, self.clock = bus, clock
+        self.reports: dict[str, HealthReport] = {}
+        self._alerted: dict[str, float] = {}
+
+    def on_report(self, payload: bytes) -> list[str]:
+        report = HealthReport.model_validate_json(payload)
+        self.reports[report.service] = report
+        self.bus.publish("health", report=json.loads(payload))
+        fired = []
+        for problem in assess(report):
+            key = problem.split(":")[0] + problem.split(":")[1][:12]
+            if self.clock() - self._alerted.get(key, -1e9) >= ALERT_COOLDOWN_S:
+                self._alerted[key] = self.clock()
+                self.bus.publish("robot_event", event="health", seq=None, detail=problem)
+                fired.append(problem)
+        return fired
diff --git a/spider-robot/brain/src/spider_brain/rec2bag.py b/spider-robot/brain/src/spider_brain/rec2bag.py
new file mode 100644
index 0000000..4251c0e
--- /dev/null
+++ b/spider-robot/brain/src/spider_brain/rec2bag.py
@@ -0,0 +1,110 @@
+"""Converts a spider recording (.sprec) to a ROS 1 bag for the Point-LIO container.
+
+  python -m spider_brain.rec2bag input.sprec output.bag
+
+Topics and frames match Unitree's point_lio_unilidar L2 launch file: unilidar/cloud and
+unilidar/imu. The point fields are x, y, z, intensity, ring, time.
+"""
+
+from __future__ import annotations
+
+import argparse
+import struct
+import sys
+from pathlib import Path
+
+import numpy as np
+
+MAGIC = b"SPREC1\n"
+_FRAME = struct.Struct("<BdII")
+KIND_CLOUD, KIND_IMU = 1, 2
+POINT_DTYPE = np.dtype([("x", "<f4"), ("y", "<f4"), ("z", "<f4"), ("intensity", "<f4"),
+                        ("ring", "<u2"), ("time", "<f4")], align=False)
+
+
+def read_frames(path: str | Path):
+    with open(path, "rb") as f:
+        if f.read(len(MAGIC)) != MAGIC:
+            raise ValueError(f"{path} is not a spider recording")
+        while True:
+            header = f.read(_FRAME.size)
+            if len(header) < _FRAME.size:
+                return
+            kind, stamp, cloud_id, size = _FRAME.unpack(header)
+            payload = f.read(size)
+            if len(payload) < size:
+                return
+            yield kind, stamp, cloud_id, payload
+
+
+def to_points(payload: bytes) -> np.ndarray:
+    raw = np.frombuffer(payload, dtype="<f4").reshape(-1, 6)
+    out = np.empty(len(raw), dtype=POINT_DTYPE)
+    for i, name in enumerate(("x", "y", "z", "intensity")):
+        out[name] = raw[:, i]
+    out["time"] = raw[:, 4]
+    out["ring"] = raw[:, 5].astype(np.uint16)
+    return out
+
+
+def convert(source: str | Path, target: str | Path) -> dict[str, int]:
+    from rosbags.rosbag1 import Writer
+    from rosbags.typesys import Stores, get_typestore
+
+    store = get_typestore(Stores.ROS1_NOETIC)
+    t = store.types
+    cloud_type, imu_type = "sensor_msgs/msg/PointCloud2", "sensor_msgs/msg/Imu"
+    time_of = t["builtin_interfaces/msg/Time"]
+    header_of = t["std_msgs/msg/Header"]
+    field_of = t["sensor_msgs/msg/PointField"]
+    # PointField datatypes: 2 = UINT16, 7 = FLOAT32
+    fields = [
+        field_of(name=n, offset=POINT_DTYPE.fields[n][1], datatype=2 if n == "ring" else 7, count=1)
+        for n in POINT_DTYPE.names
+    ]
+    counts = {"clouds": 0, "imu": 0}
+    with Writer(target) as writer:
+        cloud_conn = writer.add_connection("unilidar/cloud", cloud_type, typestore=store)
+        imu_conn = writer.add_connection("unilidar/imu", imu_type, typestore=store)
+        for kind, stamp, _cloud_id, payload in read_frames(source):
+            sec, nsec = int(stamp), int((stamp % 1.0) * 1e9)
+            ns = sec * 10**9 + nsec
+            header = header_of(seq=0, stamp=time_of(sec=sec, nanosec=nsec),
+                               frame_id="unilidar_lidar" if kind == KIND_CLOUD else "unilidar_imu")
+            if kind == KIND_CLOUD:
+                points = to_points(payload)
+                msg = t[cloud_type](
+                    header=header, height=1, width=len(points), fields=fields, is_bigendian=False,
+                    point_step=POINT_DTYPE.itemsize, row_step=POINT_DTYPE.itemsize * len(points),
+                    data=np.frombuffer(points.tobytes(), dtype=np.uint8), is_dense=True,
+                )
+                writer.write(cloud_conn, ns, store.serialize_ros1(msg, cloud_type))
+                counts["clouds"] += 1
+            elif kind == KIND_IMU:
+                d = np.frombuffer(payload, dtype="<f4").astype(np.float64)
+                quat = t["geometry_msgs/msg/Quaternion"](x=d[0], y=d[1], z=d[2], w=d[3])
+                vec = t["geometry_msgs/msg/Vector3"]
+                zeros = np.zeros(9, dtype=np.float64)
+                msg = t[imu_type](
+                    header=header, orientation=quat, orientation_covariance=zeros,
+                    angular_velocity=vec(x=d[4], y=d[5], z=d[6]),
+                    angular_velocity_covariance=zeros,
+                    linear_acceleration=vec(x=d[7], y=d[8], z=d[9]),
+                    linear_acceleration_covariance=zeros,
+                )
+                writer.write(imu_conn, ns, store.serialize_ros1(msg, imu_type))
+                counts["imu"] += 1
+    return counts
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="rec2bag")
+    parser.add_argument("source")
+    parser.add_argument("target")
+    args = parser.parse_args(argv)
+    print(convert(args.source, args.target), file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
