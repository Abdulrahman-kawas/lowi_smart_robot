diff --git a/spider-robot/infra/local/mosquitto-tls.conf b/spider-robot/infra/local/mosquitto-tls.conf
new file mode 100644
index 0000000..63c54b7
--- /dev/null
+++ b/spider-robot/infra/local/mosquitto-tls.conf
@@ -0,0 +1,11 @@
+# /etc/mosquitto/conf.d/z-spider-tls.conf. The brain over Tailscale, mutual TLS.
+# Named z- so it loads after spider.conf. Install it only after the three files below exist:
+# Mosquitto refuses to start if a listener's certificate file is missing, and that stops loopback too.
+# Bound to all interfaces because the broker must start even when tailscale0 does not exist yet;
+# nftables admits 8883 only on tailscale0.
+listener 8883 0.0.0.0
+cafile /etc/mosquitto/spider/ca.crt
+certfile /etc/mosquitto/spider/server.crt
+keyfile /etc/mosquitto/spider/server.key
+require_certificate true
+use_identity_as_username true
