@@ -0,0 +1,32 @@
+"""STT on another machine, over the same broker. Moving the worker needs no change here."""
+
+from __future__ import annotations
+
+import base64
+import time
+
+from spider_common.protocol import SttReply, SttRequest
+
+from ..interfaces import Transcript
+from ..rpc import RpcClient
+
+
+class RpcStt:
+    name = "whisper_server"
+
+    def __init__(self, rpc: RpcClient, timeout_s: float, prompt: str = "") -> None:
+        self.rpc, self.timeout_s, self.prompt = rpc, timeout_s, prompt
+
+    async def transcribe(self, pcm: bytes, rate: int, cid: str) -> Transcript:
+        started = time.perf_counter()
+        request = SttRequest(cid=cid, audio_b64=base64.b64encode(pcm).decode("ascii"),
+                             prompt=self.prompt)
+        raw = await self.rpc.call("stt", cid, request.model_dump_json(), self.timeout_s)
+        reply = SttReply.model_validate_json(raw)
+        if not reply.ok:
+            raise RuntimeError(reply.error or "server STT failed")
+        return Transcript(reply.text, reply.confidence, reply.provider or self.name,
+                          (time.perf_counter() - started) * 1000)
+
+    async def aclose(self) -> None:
+        return None
