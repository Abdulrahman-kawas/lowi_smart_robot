+++ b/spider-robot/voice/src/spider_voice/adapters/router.py
@@ -0,0 +1,88 @@
+"""LFM2.5-350M through Ollama: one JSON decision, with act emitted as soon as it is readable."""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import time
+from collections.abc import Callable
+
+import httpx
+
+from ..config import RouterCfg
+from ..interfaces import ACTS, Decision
+
+log = logging.getLogger(__name__)
+
+SYSTEM = (
+    'Robot command router. Reply only with JSON {"act":...,"say":...}. '
+    "act: forward, back, left, right, stop, look (needs the camera), ask (hard question), "
+    "none (chat). say: short reply in the user's Arabic dialect, at most 8 words."
+)
+_EARLY_ACT = re.compile(r'"act"\s*:\s*"([a-z]+)"')
+
+
+def decision_schema(say_max_chars: int) -> dict:
+    return {
+        "type": "object",
+        "properties": {
+            "act": {"type": "string", "enum": list(ACTS)},
+            "say": {"type": "string", "maxLength": say_max_chars},
+        },
+        "required": ["act", "say"],
+        "additionalProperties": False,
+    }
+
+
+def parse_decision(raw: str) -> tuple[str, str]:
+    """Output that does not parse means none."""
+    try:
+        data = json.loads(raw)
+        act, say = data["act"], data["say"]
+    except (json.JSONDecodeError, KeyError, TypeError):
+        return "none", ""
+    if act not in ACTS or not isinstance(say, str):
+        return "none", ""
+    return act, say
+
+
+class OllamaRouter:
+    name = "ollama"
+
+    def __init__(self, cfg: RouterCfg, http: httpx.AsyncClient | None = None) -> None:
+        self.cfg = cfg
+        self.http = http or httpx.AsyncClient(base_url=cfg.url, timeout=cfg.timeout_s)
+
+    def _body(self, text: str) -> dict:
+        c = self.cfg
+        return {
+            "model": c.model,
+            "stream": True,
+            "keep_alive": -1,
+            "format": decision_schema(c.say_max_chars),
+            "messages": [{"role": "system", "content": SYSTEM},
+                         {"role": "user", "content": text}],
+            "options": {"temperature": c.temperature, "num_predict": c.num_predict,
+                        "num_thread": c.num_thread, "top_k": 50, "repeat_penalty": 1.05},
+        }
+
+    async def decide(self, text: str, on_act: Callable[[str], None] | None = None) -> Decision:
+        started = time.perf_counter()
+        buffer, first_act_ms, fired = "", None, False
+        async with self.http.stream("POST", "/api/chat", json=self._body(text)) as resp:
+            resp.raise_for_status()
+            async for line in resp.aiter_lines():
+                if not line:
+                    continue
+                buffer += json.loads(line).get("message", {}).get("content", "")
+                if not fired and (m := _EARLY_ACT.search(buffer)) and m.group(1) in ACTS:
+                    fired = True
+                    first_act_ms = (time.perf_counter() - started) * 1000
+                    if on_act is not None:
+                        on_act(m.group(1))
+        act, say = parse_decision(buffer)
+        return Decision(act, say, self.name, (time.perf_counter() - started) * 1000, first_act_ms)
+
+    async def aclose(self) -> None:
+        await self.http.aclose()
