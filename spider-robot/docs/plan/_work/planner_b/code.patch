+async def _until(condition, timeout_s):
+    end = time.monotonic() + timeout_s
+    while time.monotonic() < end:
+        if condition():
+            return True
+        await asyncio.sleep(0.01)
+    return False
+
+
+@pytest.fixture
+async def world():
+    cfg = load_config(SIM_CFG, calibration="/nonexistent")
+    cfg.gait.posture_speed_mps = 0.2
+    hub = InMemoryHub()
