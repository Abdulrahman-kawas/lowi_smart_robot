+# ---------------------------------------------------------------- mapping jobs
+class FakeEc2:
+    def __init__(self, states, fail=False):
+        self.states, self.fail, self.started = list(states), fail, 0
+
+    async def start(self, instance_id):
+        if self.fail:
+            raise ConnectionError("aws down")
+        self.started += 1
+
+    async def state(self, instance_id):
+        return self.states.pop(0)
+
+
+async def jobs(ec2=None, code=0, **kw):
+    link = InMemoryHub().endpoint([])
+    await link.start()
+    calls = []
+
+    async def runner(argv):
+        calls.append(argv)
+        return code, "tail"
+
+    return MappingJobs(link, settings(**kw), EventBus(), ec2=ec2, runner=runner, poll_s=0.0), calls
+
+
+AWS = dict(aws_enabled=True, aws_instance_id="i-1", slam_aws_host="worker")
+
+
+async def test_record_publishes_a_bounded_command():
+    mj, _ = await jobs()
+    job = mj.record(99999)
+    cmd = json.loads(mj.link.published[-1].payload)
+    assert (cmd["job_id"], cmd["action"], cmd["max_s"]) == (job, "start", 3600.0)
+
+
+async def test_aws_stays_off_unless_enabled():
+    ec2 = FakeEc2(["running"])
+    mj, calls = await jobs(ec2)
+    assert "off" in await mj.process("job1", on_aws=True)
+    assert ec2.started == 0 and calls == []
+
+
+async def test_server_processing_never_touches_aws():
+    ec2 = FakeEc2([])
+    mj, calls = await jobs(ec2)
+    assert "finished" in await mj.process("job1", on_aws=False)
+    assert ec2.started == 0 and calls[0][1:] == ["job1", "localhost"]
+
+
+async def test_aws_job_starts_the_worker_then_processes():
+    ec2 = FakeEc2(["pending", "running"])
+    mj, calls = await jobs(ec2, **AWS)
+    assert "finished" in await mj.process("job1", on_aws=True)
+    assert ec2.started == 1 and calls[0][1:] == ["job1", "worker"]
+
+
+async def test_aws_failure_keeps_the_recording():
+    mj, calls = await jobs(FakeEc2([], fail=True), **AWS)
+    out = await mj.process("job1", on_aws=True)
+    assert "kept" in out and calls == []
+
+
+async def test_job_still_recording_is_refused():
+    from spider_common.protocol import RecordStatus
+
+    mj, calls = await jobs()
+    mj.on_status("t", RecordStatus(job_id="j", state="recording").model_dump_json().encode())
+    assert "still recording" in await mj.process("j", on_aws=False)
+    assert calls == []
