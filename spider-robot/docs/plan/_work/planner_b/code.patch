@@ -0,0 +1,38 @@
+"""Decides whether speech was addressed to the robot. Stop words never pass through here."""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Callable
+
+from .config import WakeCfg
+from .normalize import normalize, within_one_edit
+
+_WAKE_POSITIONS = 3  # the wake word must be near the start: "يا عنكبوت امشي"
+
+
+class Attention:
+    def __init__(self, cfg: WakeCfg, clock: Callable[[], float] = time.monotonic) -> None:
+        self.cfg, self.clock = cfg, clock
+        self.words = [normalize(w) for w in cfg.words]
+        self._until = 0.0
+
+    @property
+    def attentive(self) -> bool:
+        return self.clock() < self._until
+
+    def _extend(self) -> None:
+        self._until = self.clock() + self.cfg.window_s
+
+    def admit(self, toks: list[str]) -> tuple[bool, list[str]]:
+        """(accepted, tokens without the wake word)."""
+        if self.cfg.mode == "always":
+            return True, toks
+        for i, token in enumerate(toks[:_WAKE_POSITIONS]):
+            if any(within_one_edit(token, w) for w in self.words):
+                self._extend()
+                return True, toks[i + 1:]
+        if self.attentive:
+            self._extend()
+            return True, toks
+        return False, toks
