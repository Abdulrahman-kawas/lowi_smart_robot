@@ -0,0 +1,84 @@
+import pytest
+
+from spider_voice import grammar
+from spider_voice.attention import Attention
+from spider_voice.config import WakeCfg
+from spider_voice.normalize import normalize, tokens, within_one_edit
+
+
+def test_normalize_folds_spelling_variants():
+    assert normalize("أَوْقِفْ!") == "اوقف"
+    assert normalize("طوارئ") == normalize("طواري")
+    assert normalize("مدرسة") == "مدرسه"
+    assert tokens("يا عنكبوت، امشي.") == ["يا", "عنكبوت", "امشي"]
+
+
+@pytest.mark.parametrize("a,b,ok", [("توقف", "توقف", True), ("توقف", "توقفو", True),
+                                    ("توقف", "تقف", True), ("توقف", "امشي", False)])
+def test_within_one_edit(a, b, ok):
+    assert within_one_edit(a, b) is ok
+
+
+@pytest.mark.parametrize("text", ["قف", "وقف", "أوقف", "توقّف", "خلاص يا عنكبوت", "stop", "STOP!"])
+def test_stop_words(text):
+    assert grammar.is_stop(tokens(text))
+
+
+@pytest.mark.parametrize("text", ["وقت الغدا", "امشي قدام", "كيف حالك"])
+def test_ordinary_speech_is_not_a_stop(text):
+    assert not grammar.is_stop(tokens(text))
+
+
+def test_negated_stop_still_stops_because_a_false_stop_is_safe():
+    assert grammar.is_stop(tokens("لا توقف"))
+
+
+def test_estop_word():
+    assert grammar.is_estop(tokens("طوارئ"))
+
+
+@pytest.mark.parametrize("text,act", [
+    ("امشي", "forward"), ("روح قدام", "forward"), ("ارجع", "back"), ("لف يمين", "right"),
+    ("يسار", "left"), ("شوف", "look"), ("قوم", "stand"), ("اقعد", "sit"),
+])
+def test_commands(text, act):
+    assert grammar.match_command(tokens(text)) == act
+
+
+def test_negated_motion_is_not_a_command():
+    assert grammar.match_command(tokens("لا تمشي قدام")) is None
+    assert grammar.match_command(tokens("ما امشي")) is None
+
+
+def test_long_sentence_mentioning_a_direction_is_left_to_the_router():
+    text = "امبارح شفت سيارة قدام البيت وكانت حلوة كتير"
+    assert grammar.match_command(tokens(text)) is None
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0.0
+
+    def __call__(self):
+        return self.t
+
+
+def test_background_speech_is_not_admitted():
+    assert Attention(WakeCfg(), Clock()).admit(tokens("امشي"))[0] is False
+
+
+def test_wake_word_opens_a_window_and_is_removed():
+    clock = Clock()
+    a = Attention(WakeCfg(window_s=10), clock)
+    ok, rest = a.admit(tokens("يا عنكبوت امشي"))
+    assert ok and rest == ["امشي"]
+    clock.t = 9.0
+    assert a.admit(tokens("ارجع"))[0]  # extended again
+    clock.t = 18.5
+    assert a.admit(tokens("يمين"))[0]
+    clock.t = 40.0
+    assert not a.admit(tokens("يسار"))[0]
+
+
+def test_always_mode_admits_everything():
+    assert Attention(WakeCfg(mode="always"), Clock()).admit(["امشي"])[0]
diff --git a/spider-robot/voice/tests/test_pipeline.py b/spider-robot/voice/tests/test_pipeline.py
new file mode 100644
index 0000000..6ce2710
--- /dev/null
+++ b/spider-robot/voice/tests/test_pipeline.py
@@ -0,0 +1,371 @@
+import asyncio
+import json
+
+import numpy as np
+import pytest
+from spider_common.link import InMemoryHub
+from spider_common.protocol import AskReply, AskRequest, Move, RobotState, SttRequest, Topics
+
+from spider_voice.adapters.fakes import FakeRouter, FakeStt, FakeTts, NullOut
+from spider_voice.adapters.stt_rpc import RpcStt
+from spider_voice.adapters.tts import pcm_from_wav
+from spider_voice.bench import summary, word_errors
+from spider_voice.config import VoiceConfig
+from spider_voice.interfaces import Transcript
+from spider_voice.pipeline import VoicePipeline, clean_say, short_clause
+from spider_voice.vad import SpeechEnd
+
+ROBOT = "spider-01"
+T = Topics(ROBOT)
+LOUD = np.full(320, 8000, dtype="<i2").tobytes()
+
+
+class Loud:
+    def is_speech(self, frame, rate):
+        return frame == LOUD
+
+
+class Clock:
+    def __init__(self):
+        self.t = 100.0
+
+    def __call__(self):
+        return self.t
+
+
+def said(text, conf=0.9, name="fake"):
+    return Transcript(text, conf, name, 5.0)
+
+
+async def make(replies=(), router=None, tts=None, wake="always", **kw):
+    hub = InMemoryHub()
+    link = hub.endpoint(VoicePipeline.subscriptions(ROBOT))
+    gw = hub.endpoint([T.request("voice")])
+    await link.start()
+    await gw.start()
+    cfg = VoiceConfig()
+    cfg.wake.mode = wake
+    clock = Clock()
+    p = VoicePipeline(cfg, link, FakeStt(list(replies)), tts or FakeTts(), router or FakeRouter(),
+                      NullOut(), Loud(), clock=clock, wall=lambda: 5000.0, **kw)
+    return p, link, clock
+
+
+def cmds(link):
+    return [json.loads(m.payload) for m in link.published if m.topic == T.request("voice")]
+
+
+def segment(clock):
+    return SpeechEnd(b"\x00\x00" * 8000, clock.t - 1.0, clock.t)
+
+
+async def settle(p):
+    for _ in range(5):
+        await asyncio.sleep(0)
+    if p._tasks:
+        await asyncio.gather(*p._tasks, return_exceptions=True)
+
+
+def trace(link):
+    return json.loads([m for m in link.published if m.topic == T.voice_trace][-1].payload)
+
+
+async def utter(p, link, clock, deaf=False):
+    await p.process(segment(clock), "cid1", deaf)
+    await settle(p)
+    return cmds(link)
+
+
+# ---------------------------------------------------------------- stop path
+async def test_stop_word_never_waits_for_the_router():
+    router = FakeRouter("forward")
+    p, link, clock = await make([said("وقف")], router=router, wake="phrase")
+    out = await utter(p, link, clock)
+    assert [c["type"] for c in out] == ["stop"] and router.calls == 0
+    assert out[0]["cid"] == "cid1" and trace(link)["path"] == "stop"
+
+
+async def test_estop_word():
+    p, link, clock = await make([said("طوارئ")])
+    assert [c["type"] for c in await utter(p, link, clock)] == ["estop"]
+
+
+async def test_stop_word_works_even_in_the_deaf_window():
+    p, link, clock = await make([said("قف")])
+    assert [c["type"] for c in await utter(p, link, clock, deaf=True)] == ["stop"]
+
+
+def feed(p, clock, frames):
+    for f in frames:
+        clock.t += 0.02
+        p.on_frame(f)
+
+
+async def test_speech_onset_while_moving_stops_before_any_model():
+    stt = FakeStt([])
+    p, link, clock = await make()
+    p.stt = stt
+    p._send(Move(vx=0.05, duration_s=2.0), "m")
+    feed(p, clock, [LOUD] * 6)
+    assert [c["type"] for c in cmds(link)] == ["move", "stop"] and stt.calls == 0
+    assert p.pre_stops == 1
+
+
+async def test_no_prestop_when_standing_still():
+    p, link, clock = await make()
+    feed(p, clock, [LOUD] * 6)
+    assert cmds(link) == []
+
+
+async def test_no_prestop_from_the_robots_own_voice():
+    p, link, clock = await make()
+    p._send(Move(vx=0.05, duration_s=2.0), "m")
+    p._speaking = True
+    feed(p, clock, [LOUD] * 6)
+    assert [c["type"] for c in cmds(link)] == ["move"]
+
+
+async def test_prestop_uses_telemetry_too():
+    p, link, clock = await make()
+    p.on_message(T.state, RobotState(robot_id=ROBOT, mode="walking").model_dump_json().encode())
+    feed(p, clock, [LOUD] * 6)
+    assert [c["type"] for c in cmds(link)] == ["stop"]
+
+
+async def test_prestop_has_a_cooldown():
+    p, link, clock = await make()
+    p._send(Move(vx=0.05, duration_s=9.0), "m")
+    feed(p, clock, [LOUD] * 6)
+    p._motion_until = clock.t + 9
+    p._on_speech_start()
+    assert [c["type"] for c in cmds(link)].count("stop") == 1
+
+
+# ---------------------------------------------------------------- commands
+async def test_background_speech_never_moves_the_robot():
+    router = FakeRouter("forward")
+    p, link, clock = await make([said("امشي")], router=router, wake="phrase")
+    assert await utter(p, link, clock) == [] and router.calls == 0
+    assert trace(link)["path"] == "ignored"
+
+
+async def test_wake_word_then_command():
+    p, link, clock = await make([said("يا عنكبوت امشي")], wake="phrase")
+    out = await utter(p, link, clock)
+    assert out[0]["type"] == "move" and out[0]["vx"] == pytest.approx(0.08)
+    assert out[0]["duration_s"] == pytest.approx(2.0) and out[0]["cid"] == "cid1"
+
+
+async def test_grammar_skips_the_router_and_acknowledges():
+    router, tts = FakeRouter("back"), FakeTts()
+    p, link, clock = await make([said("امشي")], router=router, tts=tts)
+    await utter(p, link, clock)
+    assert router.calls == 0 and tts.spoken == ["حاضر"] and trace(link)["path"] == "grammar"
+
+
+@pytest.mark.parametrize("text,field,sign", [("ارجع", "vx", -1), ("يسار", "wz", 1),
+                                             ("يمين", "wz", -1)])
+async def test_each_direction(text, field, sign):
+    p, link, clock = await make([said(text)])
+    out = (await utter(p, link, clock))[0]
+    assert out[field] * sign > 0
+
+
+async def test_own_voice_cannot_command():
+    p, link, clock = await make([said("امشي")])
+    assert await utter(p, link, clock, deaf=True) == []
+
+
+async def test_router_decides_when_grammar_misses():
+    router, tts = FakeRouter("left", "تمام، بلف شوي لليسار وبعدين بكمل"), FakeTts()
+    p, link, clock = await make([said("لو سمحت دور شوي")], router=router, tts=tts)
+    out = await utter(p, link, clock)
+    assert [c["type"] for c in out] == ["move"] and out[0]["wz"] > 0  # one Move, not two
+    assert len(tts.spoken[0]) <= 30 and trace(link)["path"] == "router"
+
+
+async def test_router_failure_is_spoken_and_harmless():
+    class Broken(FakeRouter):
+        async def decide(self, text, on_act=None):
+            raise ConnectionError("ollama down")
+
+    tts = FakeTts()
+    p, link, clock = await make([said("سؤال غريب")], router=Broken(), tts=tts)
+    assert await utter(p, link, clock) == [] and tts.spoken == ["ما فهمت"]
+
+
+async def test_router_say_cannot_contain_a_stop_word():
+    assert "وقف" not in clean_say("رح وقف هون", 60)
+    assert short_clause("تمام، وبعدها بكمل", 30) == "تمام"
+
+
+# ---------------------------------------------------------------- speech recognition chain
+async def test_fallback_stt_when_primary_fails():
+    backup = FakeStt([said("امشي", name="local")], name="local")
+    p, link, clock = await make([ConnectionError("server down")], fallback_stt=backup)
+    assert (await utter(p, link, clock))[0]["type"] == "move"
+    assert trace(link)["stt_provider"] == "local"
+
+
+async def test_both_stt_failing_is_recorded_and_harmless():
+    backup = FakeStt([RuntimeError("no model")], name="local")
+    p, link, clock = await make([ConnectionError("down")], fallback_stt=backup)
+    assert await utter(p, link, clock) == [] and trace(link)["path"] == "error"
+
+
+async def test_low_confidence_miss_escalates_and_good_grammar_does_not():
+    better = FakeStt([said("امشي", name="server")], name="server")
+    p, link, clock = await make([said("كلام غير واضح", conf=0.2)], escalate_stt=better)
+    assert (await utter(p, link, clock))[0]["type"] == "move"
+    assert better.calls == 1
+    idle = FakeStt([], name="server")
+    p2, link2, clock2 = await make([said("امشي", conf=0.2)], escalate_stt=idle)
+    await utter(p2, link2, clock2)
+    assert idle.calls == 0
+
+
+async def test_escalation_failure_keeps_the_local_transcript():
+    bad = FakeStt([TimeoutError()], name="server")
+    router = FakeRouter("none", "طيب")
+    p, link, clock = await make([said("جملة", conf=0.2)], escalate_stt=bad, router=router)
+    await utter(p, link, clock)
+    assert router.calls == 1
+
+
+async def test_rpc_stt_round_trip():
+    hub = InMemoryHub()
+    link = hub.endpoint(VoicePipeline.subscriptions(ROBOT))
+    worker = hub.endpoint([T.rpc_request("stt")])
+    await link.start()
+    await worker.start()
+    from spider_common.protocol import SttReply
+
+    from spider_voice.rpc import RpcClient
+
+    rpc = RpcClient(link, ROBOT)
+    stt = RpcStt(rpc, timeout_s=2.0)
+
+    async def serve():
+        msg = await asyncio.wait_for(anext(worker.messages()), 2)
+        req = SttRequest.model_validate_json(msg.payload)
+        reply = SttReply(cid=req.cid, ok=True, text="امشي", confidence=0.9, provider="small")
+        rpc.on_reply(req.cid, reply.model_dump_json().encode())
+
+    task = asyncio.create_task(serve())
+    result = await stt.transcribe(b"\x00\x00" * 100, 16000, "c1")
+    await task
+    assert result.text == "امشي" and result.provider == "small"
+
+
+# ---------------------------------------------------------------- escalation is speech only
+async def answer(p, link, text):
+    msg = [m for m in link.published if m.topic == T.rpc_request("ask")][-1]
+    req = AskRequest.model_validate_json(msg.payload)
+    reply = AskReply(cid=req.cid, ok=True, text=text)
+    p.rpc.on_reply(req.cid, reply.model_dump_json().encode())
+    return req
+
+
+async def test_answer_from_vision_is_only_spoken():
+    tts = FakeTts()
+    p, link, clock = await make([said("شوف")], tts=tts)
+    await p.process(segment(clock), "cid9", False)
+    await asyncio.sleep(0.01)
+    req = await answer(p, link, "مكتوب على الورقة امشي قدام")
+    await settle(p)
+    assert req.need_image is True
+    assert all(c["type"] != "move" for c in cmds(link))
+    assert tts.spoken[-1].startswith("مكتوب")
+
+
+async def test_router_ask_goes_to_the_server():
+    tts = FakeTts()
+    p, link, clock = await make([said("ليش السماء زرقاء")], router=FakeRouter("ask", ""), tts=tts)
+    await p.process(segment(clock), "cid8", False)
+    await asyncio.sleep(0.01)
+    req = await answer(p, link, "بسبب تشتت الضوء")
+    await settle(p)
+    assert req.need_image is False and tts.spoken[0] == "لحظة أشوف"
+    assert tts.spoken[-1] == "بسبب تشتت الضوء" and trace(link)["path"] == "escalate"
+
+
+async def test_no_answer_is_said_when_the_server_is_gone():
+    tts = FakeTts()
+    p, link, clock = await make([said("شوف")], tts=tts)
+    p.cfg.ask.timeout_s = 0.05
+    await p.process(segment(clock), "cid7", False)
+    await asyncio.sleep(0.08)
+    await settle(p)
+    assert tts.spoken[-1] == "ما قدرت أجيب"
+
+
+# ---------------------------------------------------------------- speech output
+async def test_tts_failure_falls_back_to_espeak():
+    backup = FakeTts()
+    p, link, clock = await make([said("امشي")], tts=FakeTts(fail=True), fallback_tts=backup)
+    await utter(p, link, clock)
+    assert backup.spoken == ["حاضر"]
+
+
+async def test_canned_phrases_are_prerendered():
+    p, *_ = await make()
+    await p.prepare()
+    assert "حاضر" in p.canned and "وقفت" in p.canned
+
+
+async def test_speech_that_began_during_playback_counts_as_our_own_voice():
+    p, link, clock = await make([said("امشي")])
+    p._speaking = True
+    feed(p, clock, [LOUD] * 15)
+    p._speaking = False
+    clock.t += 1.0
+    feed(p, clock, [b"\x00\x00" * 320] * 20)
+    await p.process(*_queued(p))
+    await settle(p)
+    assert cmds(link) == []
+
+
+def _queued(p):
+    seg, cid, deaf = p._queue.popleft()
+    assert deaf
+    return seg, cid, deaf
+
+
+async def test_prepare_warms_the_router():
+    router = FakeRouter("none", "")
+    p, *_ = await make(router=router)
+    await p.prepare()
+    assert router.calls == 1
+
+
+async def test_deaf_window_lasts_past_playback():
+    p, link, clock = await make([said("امشي")])
+    await utter(p, link, clock)
+    assert p._deaf()
+    clock.t += 0.3
+    assert not p._deaf()
+
+
+async def test_trace_carries_stage_timings():
+    p, link, clock = await make([said("امشي")])
+    await utter(p, link, clock)
+    stages = trace(link)["stages_ms"]
+    assert {"stt", "command", "first_audio"} <= set(stages)
+
+
+def test_wav_header_is_stripped():
+    assert pcm_from_wav(b"RIFFxxxxWAVEfmt data\x04\x00\x00\x00ABCD") == b"ABCD"
+
+
+def test_word_error_counting():
+    assert word_errors(["a", "b", "c"], ["a", "x", "c", "d"]) == 2
+    assert summary([1.0, 2.0, 3.0])["p50"] == 2.0 and summary([]) == {"n": 0}
+
+
+async def test_load_from_the_example_config():
+    from pathlib import Path
+
+    from spider_voice.config import load_config
+
+    cfg = load_config(Path(__file__).resolve().parents[1] / "config" / "voice.example.yaml")
+    assert cfg.stt.primary == "whisper_local" and cfg.router.num_predict == 80
diff --git a/spider-robot/voice/tests/test_router.py b/spider-robot/voice/tests/test_router.py
new file mode 100644
index 0000000..4db75b4
--- /dev/null
+++ b/spider-robot/voice/tests/test_router.py
@@ -0,0 +1,65 @@
+import json
+
+import httpx
+import pytest
+
+from spider_voice.adapters.router import OllamaRouter, decision_schema, parse_decision
+from spider_voice.config import RouterCfg, VoiceConfig
+from spider_voice.interfaces import ACTS
+
+
+def stream(parts):
+    lines = [json.dumps({"message": {"content": p}}) for p in parts]
+    return "\n".join(lines) + "\n"
+
+
+def router(parts, seen=None):
+    def handler(request):
+        if seen is not None:
+            seen.append(json.loads(request.content))
+        return httpx.Response(200, text=stream(parts))
+
+    http = httpx.AsyncClient(transport=httpx.MockTransport(handler), base_url="http://x")
+    return OllamaRouter(RouterCfg(), http=http)
+
+
+async def test_act_is_available_before_the_reply_finishes():
+    order = []
+    r = router(['{"act":"for', 'ward","say":"', 'حاضر"}'])
+    d = await r.decide("امشي", on_act=lambda a: order.append(a))
+    assert order == ["forward"] and d.act == "forward" and d.say == "حاضر"
+    assert d.first_act_ms is not None
+
+
+async def test_request_shape_matches_the_brief():
+    seen = []
+    await router(['{"act":"none","say":""}'], seen).decide("مرحبا")
+    body = seen[0]
+    assert body["keep_alive"] == -1 and body["stream"] is True
+    assert 0.1 <= body["options"]["temperature"] <= 0.2
+    assert body["options"]["num_predict"] == 80
+    assert body["format"]["properties"]["act"]["enum"] == list(ACTS)
+
+
+async def test_garbage_output_means_no_action():
+    fired = []
+    d = await router(["sorry, I cannot"]).decide("x", on_act=fired.append)
+    assert (d.act, d.say, fired) == ("none", "", [])
+
+
+@pytest.mark.parametrize("raw", ['{"act":"jump","say":"x"}', '{"act":"forward"}', "[1]", ""])
+def test_parse_decision_fails_closed(raw):
+    assert parse_decision(raw) == ("none", "")
+
+
+def test_temperature_outside_the_router_band_is_refused():
+    with pytest.raises(ValueError):
+        RouterCfg(temperature=0.7)
+
+
+def test_token_budget_covers_the_longest_allowed_reply():
+    # Measured with the LFM2.5-350M tokenizer on Arabic: at most 0.78 tokens per character, and
+    # 9 tokens of JSON around say. A limit below this would cut the closing quote.
+    cfg = VoiceConfig().router
+    assert cfg.say_max_chars * 0.78 + 9 <= cfg.num_predict
+    assert decision_schema(cfg.say_max_chars)["properties"]["say"]["maxLength"] == 60
