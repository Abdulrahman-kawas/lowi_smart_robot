new file mode 100644
index 0000000..262a89b
--- /dev/null
+++ b/spider-robot/voice/tests/test_vad.py
@@ -0,0 +1,62 @@
+import numpy as np
+
+from spider_voice.config import VadCfg
+from spider_voice.vad import Segmenter, SpeechEnd, SpeechStart, make_classifier, rms_dbfs
+
+LOUD = np.full(320, 8000, dtype="<i2").tobytes()
+QUIET = np.zeros(320, dtype="<i2").tobytes()
+
+
+class Loud:
+    def is_speech(self, frame, rate):
+        return frame == LOUD
+
+
+def run(seg, frames):
+    out, t = [], 0.0
+    for f in frames:
+        t += 0.02
+        out += seg.feed(f, t)
+    return out
+
+
+def test_start_comes_early_and_end_after_the_hang():
+    seg = Segmenter(VadCfg(start_ms=100, hang_ms=300, min_speech_ms=200, preroll_ms=100), Loud())
+    events = run(seg, [QUIET] * 3 + [LOUD] * 20 + [QUIET] * 20)
+    assert isinstance(events[0], SpeechStart) and events[0].t < 0.2
+    assert isinstance(events[1], SpeechEnd) and len(events) == 2
+    assert len(events[1].pcm) >= 20 * 640
+
+
+def test_preroll_keeps_the_start_of_the_word():
+    seg = Segmenter(VadCfg(start_ms=100, hang_ms=100, min_speech_ms=100, preroll_ms=200), Loud())
+    events = run(seg, [QUIET] * 5 + [LOUD] * 8 + [QUIET] * 6)
+    assert len(events[1].pcm) > 8 * 640 + 4 * 640
+
+
+def test_short_blip_is_dropped():
+    seg = Segmenter(VadCfg(start_ms=60, hang_ms=100, min_speech_ms=400, preroll_ms=20), Loud())
+    events = run(seg, [LOUD] * 5 + [QUIET] * 8)
+    assert [type(e) for e in events] == [SpeechStart]
+
+
+def test_long_speech_is_cut_at_the_maximum():
+    seg = Segmenter(VadCfg(max_speech_ms=1000, min_speech_ms=100), Loud())
+    assert any(isinstance(e, SpeechEnd) for e in run(seg, [LOUD] * 80))
+
+
+def test_energy_gate_vetoes_the_classifier():
+    class Always:
+        def is_speech(self, frame, rate):
+            return True
+
+    seg = Segmenter(VadCfg(min_rms_dbfs=-30), Always())
+    assert run(seg, [np.full(320, 10, dtype="<i2").tobytes()] * 30) == []
+
+
+def test_rms_scale():
+    assert rms_dbfs(QUIET) < -80 and -20 < rms_dbfs(LOUD) < -10
+
+
+def test_real_webrtcvad_treats_silence_as_silence():
+    assert make_classifier(2).is_speech(QUIET, 16000) is False
