@@ -0,0 +1,217 @@
+import asyncio
+import json
+import random
+import struct
+import threading
+import time
+from pathlib import Path
+
+import numpy as np
+from spider_common.link import InMemoryHub
+from spider_common.protocol import Heartbeat, Posture, Snapshot, Topics
+
+from spider_body.config import LidarCfg, RealtimeCfg
+from spider_body.hw.camera import FakeCamera
+from spider_body.hw.lidar import LidarFeed, SimLidar, SimWorld
+from spider_body.hw.servos import FakeServoBank, SscServoBank
+from spider_body.main import control_loop
+from spider_body.realtime import apply_realtime
+from spider_body.recorder import MAGIC, RECORD, Controller, Recorder
+from spider_body.robot import Robot
+
+JOINTS = [f"{leg}.{j}" for leg in ("LF", "LM", "LR", "RF", "RM", "RR")
+          for j in ("coxa", "femur", "tibia")]
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1000.0
+
+    def __call__(self):
+        return self.t
+
+
+def make(cfg):
+    clock = Clock()
+    t = Topics(cfg.robot_id)
+    hub = InMemoryHub()
+    link = hub.endpoint([t.cmd])
+    link.connected.set()
+    world = SimWorld(obstacles=[])
+    lidar = SimLidar(cfg.lidar, world, clock=clock)
+    servos = FakeServoBank()
+    robot = Robot(cfg, servos, lidar, FakeCamera(cfg.camera), link, clock=clock,
+                  wall=lambda: 5000.0)
+    return robot, servos, lidar, clock
+
+
+class Serial:
+    def __init__(self, clock):
+        self.clock, self.at = clock, []
+
+    def write(self, data):
+        self.at.append(self.clock())
+        return len(data)
+
+
+def test_ssc_keeps_25_hz_under_tick_jitter(cfg):
+    random.seed(3)
+    t = [0.0]
+    ser = Serial(lambda: t[0])
+    bank = SscServoBank(cfg, port=ser, clock=lambda: t[0])
+    for k in range(2000):
+        t[0] = k * 0.02 + abs(random.gauss(0, 0.001))
+        bank.write({n: 90.0 + (k % 100) / 10.0 for n in JOINTS})
+    gaps = [(b - a) * 1000 for a, b in zip(ser.at, ser.at[1:], strict=False)]
+    assert sum(gaps) / len(gaps) < 41.0
+    assert max(gaps) < 45.0
+
+
+def test_wrong_version_heartbeat_does_not_feed_the_watchdog(cfg):
+    robot, _s, _l, clock = make(cfg)
+    before = robot.last_link
+    clock.t += 5
+    robot.handle(Heartbeat(ts=5000.0, v=1))
+    assert robot.last_link == before
+
+
+def test_legs_wake_one_at_a_time_after_limp(cfg):
+    robot, servos, lidar, clock = make(cfg)
+    robot.handle(Posture(posture="stand", ts=5000.0))
+    lidar.scan()
+    clock.t += 0.02
+    robot.tick(0.02)
+    assert len(servos.last) == 3
+    for _ in range(8):
+        clock.t += 0.02
+        robot.tick(0.02)
+    assert len(servos.last) == 6
+    for _ in range(50):
+        clock.t += 0.02
+        robot.handle(Heartbeat(ts=5000.0))
+        robot.tick(0.02)
+    assert len(servos.last) == 18 and robot._wake_tick is None
+
+
+async def test_control_loop_reports_lateness(cfg):
+    robot, _s, lidar, _c = make(cfg)
+    robot.clock = time.monotonic
+    lidar.clock = robot.clock
+    robot.last_link = robot.clock()
+    task = asyncio.create_task(control_loop(robot))
+    await asyncio.sleep(0.15)
+    task.cancel()
+    await asyncio.gather(task, return_exceptions=True)
+    assert sum(robot.loop_late_hist) >= 3
+    assert len(robot.state().loop_late_hist) == 6
+
+
+def test_late_histogram_buckets(cfg):
+    robot, *_ = make(cfg)
+    for ms in (0.5, 1.5, 4.0, 9.0, 19.0, 40.0):
+        robot.note_wakeup(ms)
+    assert robot.loop_late_hist == [1, 1, 1, 1, 1, 1]
+    assert robot.loop_late_max_ms == 40.0
+
+
+def _cloud(x):
+    pts = np.array([[x, 0.0, 0.0, 1.0]], dtype="<f4")
+    return [b"cloud", struct.pack("<dII", 1.0, 1, 1), pts.tobytes()]
+
+
+def test_sector_map_keeps_nearest_return_over_recent_clouds():
+    feed = LidarFeed(LidarCfg(history_clouds=3))
+    feed.handle(_cloud(1.0))
+    feed.handle(_cloud(5.0))  # the next cloud did not see the near object
+    assert feed.latest()[0].sectors_m[0] == 1.0 and feed.latest()[0].nearest_m == 1.0
+    feed.handle(_cloud(5.0))
+    feed.handle(_cloud(5.0))  # three newer clouds: the old return has aged out
+    assert feed.latest()[0].sectors_m[0] == 5.0
+
+
+def test_history_of_one_keeps_the_old_behaviour():
+    feed = LidarFeed(LidarCfg(history_clouds=1))
+    feed.handle(_cloud(1.0))
+    feed.handle(_cloud(5.0))
+    assert feed.latest()[0].sectors_m[0] == 5.0
+
+
+def test_realtime_never_raises_without_privileges():
+    report = apply_realtime(RealtimeCfg(fifo_priority=50, mlock=False, gil_switch_ms=1.0))
+    assert report["sched"] != ""
+
+
+async def test_snapshot_runs_on_the_camera_worker_not_the_loop_thread(cfg):
+    robot, *_ = make(cfg)
+    seen = []
+    real = robot.camera.snapshot
+    robot.camera.snapshot = lambda: (seen.append(threading.current_thread().name), real())[1]
+    await robot._snapshot(Snapshot(request_id="a", ts=5000.0))
+    assert seen and seen[0].startswith("camera")
+
+
+def _read_records(path: Path):
+    data = path.read_bytes()
+    assert data[:5] == MAGIC
+    head = struct.unpack_from("<I", data, 5)[0]
+    off, out = 9 + head, []
+    while off < len(data):
+        kind, _ts, hlen, plen = RECORD.unpack_from(data, off)
+        off += RECORD.size
+        out.append((kind, data[off:off + hlen], data[off + hlen:off + hlen + plen]))
+        off += hlen + plen
+    return out
+
+
+def test_recorder_roundtrip_and_time_limit(tmp_path):
+    now = [0.0]
+    rec = Recorder(tmp_path, "r1", monotonic=lambda: now[0], free_bytes=lambda p: 10**12)
+    rec.start("job1", max_s=10.0)
+    assert rec.handle([b"rawimu", b"HDR", b"P" * 40])
+    assert rec.handle([b"rawcloud", b"H2", b"Q" * 16])
+    now[0] = 11.0
+    assert not rec.handle([b"rawimu", b"HDR", b"P" * 40])
+    assert not rec.active and rec.status().state == "done" and rec.records == 2
+    records = _read_records(tmp_path / "job1" / "chunk-0000.splr")
+    assert [(k, h) for k, h, _ in records] == [(2, b"HDR"), (1, b"H2")]
+
+
+def test_recorder_stops_when_the_disk_is_nearly_full(tmp_path):
+    rec = Recorder(tmp_path, "r1", free_bytes=lambda p: 10)
+    rec.start("job2", max_s=10.0)
+    assert not rec.handle([b"rawimu", b"H", b"P"])
+    assert rec.status().state == "failed" and "disk" in rec.status().detail
+
+
+def test_recorder_rotates_chunks(tmp_path):
+    rec = Recorder(tmp_path, "r1", chunk_bytes=200, free_bytes=lambda p: 10**12)
+    rec.start("job3", max_s=10.0)
+    for _ in range(5):
+        rec.handle([b"rawcloud", b"H", b"X" * 90])
+    rec.stop()
+    assert len(list((tmp_path / "job3").glob("chunk-*.splr"))) >= 2
+
+
+async def test_controller_records_from_a_real_socket_and_reports(tmp_path):
+    import zmq
+    from spider_common.protocol import RecordCommand
+
+    pub = zmq.Context.instance().socket(zmq.PUB)
+    endpoint = f"tcp://127.0.0.1:{pub.bind_to_random_port('tcp://127.0.0.1')}"
+    hub = InMemoryHub()
+    t = Topics("r1")
+    link = hub.endpoint([])
+    await link.start()
+    rec = Recorder(tmp_path, "r1", free_bytes=lambda p: 10**12)
+    ctl = Controller(rec, link, t, endpoint)
+    await ctl.handle(RecordCommand(action="start", job_id="j1", max_s=30.0))
+    for _ in range(100):  # the subscriber needs a moment to connect
+        pub.send_multipart([b"rawimu", b"HDR", b"P" * 40])
+        await asyncio.sleep(0.01)
+        if rec.records >= 3:
+            break
+    await ctl.handle(RecordCommand(action="stop", job_id="j1"))
+    pub.close(0)
+    states = [json.loads(m.payload)["state"] for m in link.published if m.topic == t.record_status]
+    assert states[0] == "recording" and states[-1] == "done"
+    assert not rec.active and rec.records >= 3
