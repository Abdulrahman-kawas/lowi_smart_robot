index 0000000..2a57e58
--- /dev/null
+++ b/spider-robot/brain/src/spider_brain/aws_job.py
@@ -0,0 +1,117 @@
+"""Mapping jobs: record on the robot, process a copy elsewhere. AWS starts only when asked.
+
+Recording never depends on AWS. If the worker cannot start, the recording stays where it is and the
+owner is told. The worker stops itself; this module only starts it. Credentials allow start, stop
+and describe on one instance, and the Pi has none.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import time
+from pathlib import Path
+from typing import Protocol
+
+from spider_common.link import Link
+from spider_common.protocol import RecordCommand, RecordStatus, Topics
+
+from .config import Settings
+from .supervision.events import EventBus
+
+log = logging.getLogger(__name__)
+
+BRAIN_ROOT = Path(__file__).resolve().parents[2]
+
+
+class Ec2Api(Protocol):
+    async def start(self, instance_id: str) -> None: ...
+
+    async def state(self, instance_id: str) -> str: ...
+
+
+class Boto3Ec2:
+    def __init__(self, region: str) -> None:
+        import boto3
+
+        self.client = boto3.client("ec2", region_name=region)
+
+    async def start(self, instance_id: str) -> None:
+        await asyncio.to_thread(self.client.start_instances, InstanceIds=[instance_id])
+
+    async def state(self, instance_id: str) -> str:
+        out = await asyncio.to_thread(self.client.describe_instances, InstanceIds=[instance_id])
+        return out["Reservations"][0]["Instances"][0]["State"]["Name"]
+
+
+async def run_script(argv: list[str]) -> tuple[int, str]:
+    proc = await asyncio.create_subprocess_exec(
+        *argv, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT
+    )
+    out, _ = await proc.communicate()
+    return proc.returncode or 0, out.decode("utf-8", "replace")[-500:]
+
+
+class MappingJobs:
+    def __init__(self, link: Link, settings: Settings, bus: EventBus, ec2: Ec2Api | None = None,
+                 runner=run_script, poll_s: float = 5.0) -> None:
+        self.link, self.settings, self.bus = link, settings, bus
+        self._ec2, self.runner, self.poll_s = ec2, runner, poll_s
+        self.topics = Topics(settings.robot_id)
+        self.status: dict[str, RecordStatus] = {}
+        self._processing = False
+
+    def record(self, seconds: float) -> str:
+        job = time.strftime("job-%Y%m%d-%H%M%S")
+        cmd = RecordCommand(action="start", job_id=job, max_s=max(1.0, min(3600.0, seconds)))
+        self.link.publish(self.topics.record_cmd, cmd.model_dump_json(), qos=1)
+        return job
+
+    def on_status(self, _topic: str, payload: bytes) -> None:
+        status = RecordStatus.model_validate_json(payload)
+        self.status[status.job_id] = status
+        self.bus.publish("message", text=f"Recording {status.job_id}: {status.state} "
+                                         f"({status.bytes_written / 1e6:.0f} MB) {status.detail}")
+
+    def _api(self) -> Ec2Api:
+        if self._ec2 is None:
+            self._ec2 = Boto3Ec2(self.settings.aws_region)
+        return self._ec2
+
+    async def _start_worker(self) -> bool:
+        s = self.settings
+        api = self._api()
+        await api.start(s.aws_instance_id)
+        end = time.monotonic() + s.aws_start_timeout_s
+        while time.monotonic() < end:
+            if await api.state(s.aws_instance_id) == "running":
+                return True
+            await asyncio.sleep(self.poll_s)
+        return False
+
+    async def process(self, job_id: str, on_aws: bool) -> str:
+        s = self.settings
+        status = self.status.get(job_id)
+        if status is not None and status.state == "recording":
+            return f"{job_id} is still recording."
+        if self._processing:
+            return "Another mapping job is running."
+        if on_aws and not (s.aws_enabled and s.aws_instance_id and s.slam_aws_host):
+            return "AWS is off in the settings. The recording is kept."
+        self._processing = True
+        try:
+            if on_aws:
+                try:
+                    started = await self._start_worker()
+                except Exception as exc:
+                    log.warning("AWS start failed: %r", exc)
+                    started = False
+                if not started:
+                    return f"The AWS worker did not start. {job_id} is kept and waits."
+            host = s.slam_aws_host if on_aws else s.slam_server_host
+            script = Path(s.slam_script)
+            path = script if script.is_absolute() else (BRAIN_ROOT / script).resolve()
+            code, tail = await self.runner([str(path), job_id, host])
+            return f"Mapping {job_id} finished." if code == 0 else f"Mapping failed: {tail}"
+        finally:
+            self._processing = False
