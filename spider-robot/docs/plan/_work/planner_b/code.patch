new file mode 100644
index 0000000..4f99d6e
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/adapters/audio.py
@@ -0,0 +1,79 @@
+"""Microphone through PyAudio, playback through a player process that can be killed at once."""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+from collections.abc import AsyncIterator, Callable
+
+log = logging.getLogger(__name__)
+
+_QUEUE_FRAMES = 200  # 4 s at 20 ms; the oldest audio is dropped if the loop falls behind
+
+
+async def pyaudio_frames(rate: int, frame_ms: int, device: int | None) -> AsyncIterator[bytes]:
+    import pyaudio
+
+    loop = asyncio.get_running_loop()
+    queue: asyncio.Queue[bytes] = asyncio.Queue(maxsize=_QUEUE_FRAMES)
+
+    def put(data: bytes) -> None:
+        if queue.full():
+            queue.get_nowait()
+        queue.put_nowait(data)
+
+    def callback(data, _count, _time, _status):
+        loop.call_soon_threadsafe(put, bytes(data))
+        return None, pyaudio.paContinue
+
+    pa = pyaudio.PyAudio()
+    stream = pa.open(format=pyaudio.paInt16, channels=1, rate=rate, input=True,
+                     input_device_index=device, frames_per_buffer=rate * frame_ms // 1000,
+                     stream_callback=callback)
+    try:
+        while True:
+            yield await queue.get()
+    finally:
+        stream.stop_stream()
+        stream.close()
+        pa.terminate()
+
+
+class PlayerOut:
+    def __init__(self, argv: list[str]) -> None:
+        self.argv = argv
+        self._proc: asyncio.subprocess.Process | None = None
+
+    async def play(
+        self, chunks: AsyncIterator[bytes], rate: int, on_first: Callable[[], None] | None = None
+    ) -> None:
+        proc = await asyncio.create_subprocess_exec(
+            *self.argv, "-t", "raw", "-f", "S16_LE", "-c", "1", "-r", str(rate), "-",
+            stdin=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
+        )
+        self._proc = proc
+        first = True
+        try:
+            async for chunk in chunks:
+                if first and on_first is not None:
+                    on_first()
+                first = False
+                assert proc.stdin is not None
+                proc.stdin.write(chunk)
+                await proc.stdin.drain()
+            assert proc.stdin is not None
+            proc.stdin.close()
+            await proc.wait()
+        except (BrokenPipeError, ConnectionResetError):
+            log.debug("playback interrupted")
+        finally:
+            if proc.returncode is None:
+                self.stop()
+                await proc.wait()
+            self._proc = None
+
+    def stop(self) -> None:
+        if self._proc is not None and self._proc.returncode is None:
+            with contextlib.suppress(ProcessLookupError):
+                self._proc.kill()
diff --git a/spider-robot/voice/src/spider_voice/adapters/fakes.py b/spider-robot/voice/src/spider_voice/adapters/fakes.py
new file mode 100644
index 0000000..093d8d5
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/adapters/fakes.py
@@ -0,0 +1,70 @@
+"""Deterministic adapters for tests and for running the loop with no audio hardware."""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator, Callable
+
+from ..interfaces import Decision, Transcript
+
+
+class FakeStt:
+    def __init__(self, replies: list[Transcript | Exception], name: str = "fake") -> None:
+        self.replies, self.name, self.calls = list(replies), name, 0
+
+    async def transcribe(self, pcm: bytes, rate: int, cid: str) -> Transcript:
+        self.calls += 1
+        reply = self.replies.pop(0)
+        if isinstance(reply, Exception):
+            raise reply
+        return reply
+
+    async def aclose(self) -> None:
+        return None
+
+
+class FakeRouter:
+    name = "fake"
+
+    def __init__(self, act: str = "none", say: str = "") -> None:
+        self.act, self.say, self.calls = act, say, 0
+
+    async def decide(self, text: str, on_act: Callable[[str], None] | None = None) -> Decision:
+        self.calls += 1
+        if on_act is not None:
+            on_act(self.act)
+        return Decision(self.act, self.say, self.name, 1.0, 0.5)
+
+    async def aclose(self) -> None:
+        return None
+
+
+class FakeTts:
+    name = "fake"
+    rate = 16000
+
+    def __init__(self, fail: bool = False) -> None:
+        self.fail, self.spoken = fail, []
+
+    async def stream(self, text: str) -> AsyncIterator[bytes]:
+        if self.fail:
+            raise RuntimeError("tts down")
+        self.spoken.append(text)
+        yield b"\x00\x00" * 160
+
+    async def aclose(self) -> None:
+        return None
+
+
+class NullOut:
+    def __init__(self) -> None:
+        self.played, self.stops = 0, 0
+
+    async def play(self, chunks, rate: int, on_first=None) -> None:
+        async for _chunk in chunks:
+            if on_first is not None:
+                on_first()
+                on_first = None
+            self.played += 1
+
+    def stop(self) -> None:
+        self.stops += 1
