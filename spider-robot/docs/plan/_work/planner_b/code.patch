diff --git a/spider-robot/infra/pi/deploy.sh b/spider-robot/infra/pi/deploy.sh
new file mode 100644
index 0000000..5392613
--- /dev/null
+++ b/spider-robot/infra/pi/deploy.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+# Updates a running robot, run on the Pi from an unpacked copy of spider-robot:
+#   bash infra/pi/deploy.sh
+# Refuses unless the robot is sitting or relaxed. Keeps the previous release and goes back to it
+# by itself if a service does not come up. The gateway restarts before voice and body.
+set -euo pipefail
+SR="$(cd "$(dirname "$0")/../.." && pwd)"
+ROOT=/opt/spider
+LINK="$ROOT/spider-robot"
+RELEASES="$ROOT/releases"
+ROBOT_ID="${ROBOT_ID:-spider-01}"
+PYTHON_VERSION="${PYTHON_VERSION:-3.12}"
+SERVICES=(spider-gateway spider-voice spider-body)
+SECRET="$(sudo cat /etc/spider/secrets/spider-health.mqtt)"
+
+mode() {  # the body's retained-free state, one message, 3 s at most
+  mosquitto_sub -h 127.0.0.1 -p 1883 -u spider-health -P "$SECRET" -C 1 -W 3 \
+    -t "spider/$ROBOT_ID/gw/status" | python3 -c 'import json,sys; print(json.load(sys.stdin)["mode"])'
+}
+
+current_mode="$(mode || echo unknown)"
+case "$current_mode" in
+  relaxed|sitting) ;;
+  *) echo "refusing: the robot is '$current_mode'. Sit it down first."; exit 1 ;;
+esac
+
+sudo install -d -o "$USER" "$RELEASES"
+if [[ -d "$LINK" && ! -L "$LINK" ]]; then   # first deploy after setup_pi.sh
+  sudo mv "$LINK" "$RELEASES/initial"
+  sudo ln -s "$RELEASES/initial" "$LINK"
+fi
+previous="$(readlink -f "$LINK")"
+release="$RELEASES/$(date +%Y%m%d-%H%M%S)"
+rsync -a --exclude .venv --exclude __pycache__ --exclude docs "$SR/" "$release/"
+export UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/opt/spider/python
+for pkg in body gateway; do
+  (cd "$release/$pkg" && uv sync --frozen --no-dev --python "$PYTHON_VERSION")
+done
+(cd "$release/voice" && uv sync --frozen --no-dev --group pi --python "$PYTHON_VERSION")
+sudo chown -R spider:spider "$release"
+
+activate() {
+  sudo ln -sfn "$1" "$LINK"
+  sudo systemctl restart "${SERVICES[@]}"
+  sleep 8
+  for svc in "${SERVICES[@]}"; do
+    systemctl is-active --quiet "$svc" || return 1
+  done
+}
+
+if activate "$release"; then
+  echo "deployed $release (previous: $previous)"
+  ls -1dt "$RELEASES"/* | tail -n +4 | xargs -r sudo rm -rf   # keep three
+else
+  echo "a service failed; going back to $previous"
+  activate "$previous"
+  exit 1
+fi
