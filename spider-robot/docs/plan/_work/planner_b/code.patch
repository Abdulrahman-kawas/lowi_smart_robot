@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# Called by the brain with a fixed argv: process_job.sh <job_id> <host>
+# Copies the recording from the Pi, then maps on this machine or on the worker.
+set -euo pipefail
+JOB="$1"
+HOST="$2"
+[[ "$JOB" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "bad job id"; exit 2; }
+PI="${SPIDER_PI_NAME:?set SPIDER_PI_NAME}"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+LOCAL="/var/lib/spider-brain/recordings/$JOB"
+mkdir -p "$LOCAL"
+rsync -a --partial "spider@$PI:/var/lib/spider/recordings/$JOB/" "$LOCAL/"
+if [[ "$HOST" == "localhost" ]]; then
+  bash "$HERE/run_slam.sh" "$LOCAL"
+  exit 0
+fi
+ssh "$HOST" "mkdir -p jobs/$JOB slam"
+rsync -a --partial "$LOCAL/" "$HOST:jobs/$JOB/"
+rsync -a "$HERE/" "$HOST:slam/"
+ssh "$HOST" "bash slam/run_slam.sh jobs/$JOB"
+rsync -a "$HOST:jobs/$JOB/*.pcd" "$LOCAL/"
+ssh "$HOST" "sudo shutdown -h now" || true   # the job is done; the worker's own timer is the backup
diff --git a/spider-robot/infra/slam/rec2bag.py b/spider-robot/infra/slam/rec2bag.py
new file mode 100644
index 0000000..535d59d
--- /dev/null
+++ b/spider-robot/infra/slam/rec2bag.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Converts a SPLR recording to a ROS 1 bag for Point-LIO. Needs only the rosbags package.
+
+  python rec2bag.py /path/to/job-dir output.bag
+"""
+
+from __future__ import annotations
+
+import json
+import struct
+import sys
+from pathlib import Path
+
+import numpy as np
+from rosbags.rosbag1 import Writer
+from rosbags.typesys import Stores, get_typestore
+
+MAGIC = b"SPLR\x01"
+RECORD = struct.Struct("<BdII")
+CLOUD_TOPIC, IMU_TOPIC, FRAME = "/unilidar/cloud", "/unilidar/imu", "unilidar_lidar"
+POINT = np.dtype([("x", "<f4"), ("y", "<f4"), ("z", "<f4"), ("intensity", "<f4"),
+                  ("ring", "<u2"), ("pad", "<u2"), ("time", "<f4")])
+
+
+def records(path: Path):
+    data = path.read_bytes()
+    if data[:5] != MAGIC:
+        raise ValueError(f"{path}: not a SPLR file")
+    head = struct.unpack_from("<I", data, 5)[0]
+    offset = 9 + head
+    json.loads(data[9:offset])
+    while offset + RECORD.size <= len(data):
+        kind, rx, hlen, plen = RECORD.unpack_from(data, offset)
+        start = offset + RECORD.size
+        if start + hlen + plen > len(data):
+            return  # the last record of a crashed recording is cut short
+        yield kind, rx, data[start:start + hlen], data[start + hlen:start + hlen + plen]
+        offset = start + hlen + plen
+
+
+def convert(job_dir: Path, output: Path) -> dict:
+    store = get_typestore(Stores.ROS1_NOETIC)
+    Header = store.types["std_msgs/msg/Header"]
+    Time = store.types["builtin_interfaces/msg/Time"]
+    Field = store.types["sensor_msgs/msg/PointField"]
+    Cloud = store.types["sensor_msgs/msg/PointCloud2"]
+    Imu = store.types["sensor_msgs/msg/Imu"]
+    Quaternion = store.types["geometry_msgs/msg/Quaternion"]
+    Vector3 = store.types["geometry_msgs/msg/Vector3"]
+    fields = [Field(name=n, offset=o, datatype=d, count=1) for n, o, d in (
+        ("x", 0, 7), ("y", 4, 7), ("z", 8, 7), ("intensity", 12, 7), ("ring", 16, 4),
+        ("time", 20, 7))]
+    zeros = np.zeros(9, dtype=np.float64)
+    counts = {"clouds": 0, "imu": 0}
+
+    def header(seq: int, stamp: float):
+        sec = int(stamp)
+        return Header(seq=seq, stamp=Time(sec=sec, nanosec=int((stamp - sec) * 1e9)), frame_id=FRAME)
+
+    with Writer(output) as bag:
+        cloud_conn = bag.add_connection(CLOUD_TOPIC, Cloud.__msgtype__, typestore=store)
+        imu_conn = bag.add_connection(IMU_TOPIC, Imu.__msgtype__, typestore=store)
+        for chunk in sorted(job_dir.glob("chunk-*.splr")):
+            for kind, _rx, hdr, payload in records(chunk):
+                if kind == 1:
+                    stamp, _cid, n = struct.unpack("<dII", hdr)
+                    raw = np.frombuffer(payload, dtype="<f4").reshape(n, 6)
+                    pts = np.zeros(n, dtype=POINT)
+                    pts["x"], pts["y"], pts["z"], pts["intensity"] = raw[:, 0], raw[:, 1], raw[:, 2], raw[:, 3]
+                    pts["time"], pts["ring"] = raw[:, 4], raw[:, 5].astype(np.uint16)
+                    msg = Cloud(header=header(counts["clouds"], stamp), height=1, width=n,
+                                fields=fields, is_bigendian=False, point_step=POINT.itemsize,
+                                row_step=POINT.itemsize * n,
+                                data=np.frombuffer(pts.tobytes(), dtype=np.uint8), is_dense=True)
+                    bag.write(cloud_conn, int(stamp * 1e9), store.serialize_ros1(msg, Cloud.__msgtype__))
+                    counts["clouds"] += 1
+                elif kind == 2:
+                    stamp = struct.unpack("<d", hdr)[0]
+                    d = np.frombuffer(payload, dtype="<f4").astype(np.float64)
+                    msg = Imu(header=header(counts["imu"], stamp),
+                              orientation=Quaternion(x=d[0], y=d[1], z=d[2], w=d[3]),
+                              orientation_covariance=zeros,
+                              angular_velocity=Vector3(x=d[4], y=d[5], z=d[6]),
+                              angular_velocity_covariance=zeros,
+                              linear_acceleration=Vector3(x=d[7], y=d[8], z=d[9]),
+                              linear_acceleration_covariance=zeros)
+                    bag.write(imu_conn, int(stamp * 1e9), store.serialize_ros1(msg, Imu.__msgtype__))
+                    counts["imu"] += 1
+    return counts
+
+
+if __name__ == "__main__":
+    print(convert(Path(sys.argv[1]), Path(sys.argv[2])))
