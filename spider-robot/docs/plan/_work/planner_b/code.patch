@@ -0,0 +1,52 @@
+"""Structured logs for every process: one JSON object per line, ready for journald and jq.
+
+Every record carries the service name. Pass extra={"cid": ...} to tie a line to an utterance
+or task; the same correlation id is on the command, the gateway log, and the voice trace.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import sys
+import time
+import uuid
+
+_STANDARD = set(logging.LogRecord("", 0, "", 0, "", (), None).__dict__) | {"message", "asctime"}
+
+
+def new_cid() -> str:
+    return uuid.uuid4().hex[:12]
+
+
+class JsonFormatter(logging.Formatter):
+    def __init__(self, service: str) -> None:
+        super().__init__()
+        self.service = service
+
+    def format(self, record: logging.LogRecord) -> str:
+        out = {
+            "ts": round(time.time(), 3),
+            "lvl": record.levelname,
+            "svc": self.service,
+            "log": record.name,
+            "msg": record.getMessage(),
+        }
+        for key, value in record.__dict__.items():
+            if key not in _STANDARD and not key.startswith("_"):
+                out[key] = value
+        if record.exc_info:
+            out["exc"] = self.formatException(record.exc_info)
+        return json.dumps(out, ensure_ascii=False, default=str)
+
+
+def setup_logging(service: str, level: str = "INFO", json_lines: bool = True) -> None:
+    root = logging.getLogger()
+    root.handlers.clear()
+    root.setLevel(level)
+    handler = logging.StreamHandler(sys.stderr)
+    if json_lines:
+        handler.setFormatter(JsonFormatter(service))
+    else:
+        handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(name)s: %(message)s"))
+    root.addHandler(handler)
