diff --git a/spider-robot/common/src/spider_common/health.py b/spider-robot/common/src/spider_common/health.py
new file mode 100644
index 0000000..b47525b
--- /dev/null
+++ b/spider-robot/common/src/spider_common/health.py
@@ -0,0 +1,132 @@
+"""spider-health: one small process per node, reporting what the alerts need every 10 s."""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import logging
+import os
+import shutil
+import socket
+import subprocess
+from pathlib import Path
+
+from .link import MqttLink, MqttSettings
+from .protocol import HealthReport, Topics
+from .telemetry import setup_logging
+
+log = logging.getLogger(__name__)
+
+PERIOD_S = 10.0
+WATCHED = ("spider-", "mosquitto", "ollama", "tailscaled", "llama-")
+
+
+def _run(argv: list[str]) -> str | None:
+    if shutil.which(argv[0]) is None:
+        return None
+    try:
+        return subprocess.run(argv, capture_output=True, text=True, timeout=4.0, check=False).stdout
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+
+
+def parse_meminfo(text: str) -> tuple[float | None, float | None]:
+    values: dict[str, float] = {}
+    for line in text.splitlines():
+        name, _, rest = line.partition(":")
+        fields = rest.split()
+        if fields:
+            values[name] = float(fields[0]) / 1024.0
+    swap = None
+    if "SwapTotal" in values and "SwapFree" in values:
+        swap = round(values["SwapTotal"] - values["SwapFree"], 1)
+    available = values.get("MemAvailable")
+    return (None if available is None else round(available, 1)), swap
+
+
+def parse_throttled(text: str | None) -> str | None:
+    if not text or "=" not in text:
+        return None
+    return text.strip().split("=", 1)[1]
+
+
+def parse_failed_units(text: str | None) -> list[str]:
+    if not text:
+        return []
+    units = [line.split()[0] for line in text.splitlines() if line.strip()]
+    return [u for u in units if u.startswith(WATCHED)]
+
+
+def parse_tailscale_path(text: str | None, peer: str) -> str | None:
+    """direct, relay, or none when the peer is offline. None means Tailscale is not available."""
+    if not text or not peer:
+        return None
+    try:
+        peers = json.loads(text).get("Peer") or {}
+    except ValueError:
+        return None
+    for node in peers.values():
+        if node.get("HostName") == peer or node.get("DNSName", "").startswith(f"{peer}."):
+            if not node.get("Online"):
+                return "none"
+            if node.get("CurAddr"):
+                return "direct"
+            if node.get("PeerRelay"):
+                return "peer-relay"
+            return "relay" if node.get("Relay") else "none"
+    return "none"
+
+
+def collect(node: str, peer: str, disk_path: str = "/") -> HealthReport:
+    temp = None
+    zone = Path("/sys/class/thermal/thermal_zone0/temp")
+    if zone.exists():
+        temp = round(float(zone.read_text()) / 1000.0, 1)
+    meminfo = Path("/proc/meminfo")
+    available, swap = parse_meminfo(meminfo.read_text()) if meminfo.exists() else (None, None)
+    failed = _run(["systemctl", "--failed", "--plain", "--no-legend", "--no-pager"])
+    return HealthReport(
+        node=node, cpu_temp_c=temp, mem_available_mb=available, swap_used_mb=swap,
+        throttled_hex=parse_throttled(_run(["vcgencmd", "get_throttled"])),
+        disk_free_mb=round(shutil.disk_usage(disk_path).free / 1048576.0, 1),
+        failed_units=parse_failed_units(failed),
+        tailscale_path=parse_tailscale_path(_run(["tailscale", "status", "--json"]), peer),
+    )
+
+
+def _settings() -> MqttSettings:
+    env = os.environ.get
+    secret = env("SH_MQTT_PASSWORD_FILE")
+    return MqttSettings(
+        host=env("SH_MQTT_HOST", "127.0.0.1"), port=int(env("SH_MQTT_PORT", "1883")),
+        client_id=f"spider-health-{socket.gethostname()}", tls=env("SH_MQTT_TLS", "0") == "1",
+        ca_path=env("SH_MQTT_CA_PATH"), cert_path=env("SH_MQTT_CERT_PATH"),
+        key_path=env("SH_MQTT_KEY_PATH"), username=env("SH_MQTT_USERNAME"),
+        password=Path(secret).read_text("utf-8").strip() if secret else None,
+    )
+
+
+async def _run_loop(node: str, peer: str, robot_id: str) -> None:
+    link = MqttLink(_settings(), [])
+    topic = Topics(robot_id).health
+    await link.start()
+    while True:
+        report = await asyncio.to_thread(collect, node, peer)
+        link.publish(topic, report.model_dump_json(), qos=0)
+        await asyncio.sleep(PERIOD_S)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="spider-health")
+    parser.add_argument("--node", required=True)
+    parser.add_argument("--peer", default="")
+    parser.add_argument("--robot-id", default="spider-01")
+    args = parser.parse_args(argv)
+    setup_logging("spider-health")
+    asyncio.run(_run_loop(args.node, args.peer, args.robot_id))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
