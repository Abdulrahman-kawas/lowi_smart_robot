+"""Fixed mapping from an act to one protocol command. Motion is short and ends by itself."""
+
+from __future__ import annotations
+
+from spider_common.protocol import Command, Move, Posture, Stop
+
+from .config import MotionCfg
+
+MOTION_ACTS = frozenset({"forward", "back", "left", "right"})
+
+
+def to_command(act: str, m: MotionCfg) -> Command | None:
+    if act == "forward":
+        return Move(vx=m.speed_mps, duration_s=m.forward_s, gait=m.gait)
+    if act == "back":
+        return Move(vx=-m.speed_mps, duration_s=m.back_s, gait=m.gait)
+    if act == "left":
+        return Move(wz=m.turn_rps, duration_s=m.turn_s, gait=m.gait)
+    if act == "right":
+        return Move(wz=-m.turn_rps, duration_s=m.turn_s, gait=m.gait)
+    if act == "stop":
+        return Stop()
+    if act in ("stand", "sit"):
+        return Posture(posture=act)
+    return None
