+    link, voice, _ = await worker_rig(chat_ok("x"))
+    svc = AskService(link, settings(), Snap(), Vision(), [Slow()])
+    svc.on_request("t", AskRequest(cid="b1", text="a").model_dump_json().encode())
+    svc.on_request("t", AskRequest(cid="b2", text="b").model_dump_json().encode())
+    busy = await reply_of(voice, AskReply)
+    assert (busy.cid, busy.ok, busy.error) == ("b2", False, "busy")
+    gate.set()
+    assert (await reply_of(voice, AskReply)).cid == "b1"
+
