+async def stand(robot, voice):
+    voice.publish(T.request("voice"), Posture(seq=1, session="v", ts=time.time(),
+                                              posture="stand").model_dump_json())
+    assert await _until(lambda: robot.mode == "standing" and robot._height_reached(), 15.0)
