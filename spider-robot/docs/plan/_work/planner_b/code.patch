@@ -0,0 +1,33 @@
+"""Request and reply over MQTT. The worker can run on any machine with a broker login."""
+
+from __future__ import annotations
+
+import asyncio
+
+from spider_common.link import Link
+from spider_common.protocol import Topics
+
+
+class RpcClient:
+    def __init__(self, link: Link, robot_id: str, client: str = "voice") -> None:
+        self.link, self.client = link, client
+        self.topics = Topics(robot_id)
+        self._waiting: dict[str, asyncio.Future[bytes]] = {}
+
+    def reply_topics(self, services: tuple[str, ...] = ("ask", "stt")) -> list[str]:
+        return [self.topics.rpc_reply(s, self.client) for s in services]
+
+    async def call(self, service: str, cid: str, payload: str, timeout_s: float) -> bytes:
+        future: asyncio.Future[bytes] = asyncio.get_running_loop().create_future()
+        self._waiting[cid] = future
+        try:
+            if not self.link.publish(self.topics.rpc_request(service), payload, qos=1):
+                raise ConnectionError("broker not connected")
+            return await asyncio.wait_for(future, timeout_s)
+        finally:
+            self._waiting.pop(cid, None)
+
+    def on_reply(self, cid: str, payload: bytes) -> None:
+        future = self._waiting.get(cid)
+        if future is not None and not future.done():
+            future.set_result(payload)
diff --git a/spider-robot/voice/src/spider_voice/vad.py b/spider-robot/voice/src/spider_voice/vad.py
new file mode 100644
index 0000000..1627b1c
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/vad.py
@@ -0,0 +1,90 @@
+"""Turns 20 ms audio frames into SpeechStart and SpeechEnd. Cheap enough to run on every frame."""
+
+from __future__ import annotations
+
+import math
+from collections import deque
+from dataclasses import dataclass
+from typing import Protocol
+
+import numpy as np
+
+from .config import VadCfg
+
+
+class FrameClassifier(Protocol):
+    def is_speech(self, frame: bytes, rate: int) -> bool: ...
+
+
+@dataclass(frozen=True)
+class SpeechStart:
+    t: float
+
+
+@dataclass(frozen=True)
+class SpeechEnd:
+    pcm: bytes
+    t_start: float
+    t_end: float
+
+
+def rms_dbfs(frame: bytes) -> float:
+    samples = np.frombuffer(frame, dtype="<i2").astype(np.float64)
+    if samples.size == 0:
+        return -120.0
+    rms = float(np.sqrt(np.mean(samples * samples)))
+    return 20.0 * math.log10(max(rms, 1.0) / 32768.0)
+
+
+def make_classifier(aggressiveness: int) -> FrameClassifier:
+    import webrtcvad
+
+    return webrtcvad.Vad(aggressiveness)
+
+
+class Segmenter:
+    def __init__(self, cfg: VadCfg, classifier: FrameClassifier, rate: int = 16000,
+                 frame_ms: int = 20) -> None:
+        self.cfg, self.vad, self.rate, self.frame_ms = cfg, classifier, rate, frame_ms
+        self._start_frames = max(1, cfg.start_ms // frame_ms)
+        self._hang_frames = max(1, cfg.hang_ms // frame_ms)
+        self._min_frames = cfg.min_speech_ms // frame_ms
+        self._max_frames = cfg.max_speech_ms // frame_ms
+        self._preroll: deque[bytes] = deque(maxlen=max(1, cfg.preroll_ms // frame_ms))
+        self._voiced = 0
+        self._silent = 0
+        self._speaking = False
+        self._frames: list[bytes] = []
+        self._t_start = 0.0
+
+    def _classify(self, frame: bytes) -> bool:
+        return rms_dbfs(frame) >= self.cfg.min_rms_dbfs and self.vad.is_speech(frame, self.rate)
+
+    def feed(self, frame: bytes, t: float) -> list[SpeechStart | SpeechEnd]:
+        voiced = self._classify(frame)
+        if not self._speaking:
+            self._preroll.append(frame)
+            self._voiced = self._voiced + 1 if voiced else 0
+            if self._voiced < self._start_frames:
+                return []
+            self._speaking = True
+            self._silent = 0
+            self._frames = list(self._preroll)
+            self._preroll.clear()
+            self._t_start = t
+            return [SpeechStart(t)]
+        self._frames.append(frame)
+        self._silent = 0 if voiced else self._silent + 1
+        if self._silent >= self._hang_frames or len(self._frames) >= self._max_frames:
+            return self._finish(t)
+        return []
+
+    def _finish(self, t: float) -> list[SpeechStart | SpeechEnd]:
+        frames, self._frames = self._frames, []
+        self._speaking = False
+        self._voiced = 0
+        spoken = len(frames) - self._silent
+        self._silent = 0
+        if spoken < self._min_frames:
+            return []
+        return [SpeechEnd(b"".join(frames), self._t_start, t)]
