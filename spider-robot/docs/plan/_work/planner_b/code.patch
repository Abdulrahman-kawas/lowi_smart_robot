index 0000000..da9ffd6
--- /dev/null
+++ b/spider-robot/infra/slam/run_slam.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# Runs on the machine that does the mapping (home server or the AWS worker).
+#   run_slam.sh /path/to/job-dir
+set -euo pipefail
+DIR="$(cd "$1" && pwd)"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+touch /var/lib/spider-job/last_activity 2>/dev/null || true
+uv run --no-project --with "rosbags==0.11.9" --with numpy python -I "$HERE/rec2bag.py" "$DIR" "$DIR/recording.bag"
+docker build -q -t spider-point-lio "$HERE" >/dev/null
+docker run --rm --cpus="${SLAM_CPUS:-4}" --memory="${SLAM_MEMORY:-4g}" -v "$DIR:/job" spider-point-lio bash -c '
+  source /ws/devel/setup.bash
+  roslaunch point_lio_unilidar mapping_unilidar_l2.launch rviz:=false &
+  sleep 5
+  rosbag play --quiet --rate 1.0 /job/recording.bag
+  sleep 5
+  rosnode kill -a
+  sleep 3
+  cp /ws/src/point_lio_unilidar/PCD/*.pcd /job/ 2>/dev/null || true
+'
+touch /var/lib/spider-job/last_activity 2>/dev/null || true
+ls -la "$DIR"/*.pcd
