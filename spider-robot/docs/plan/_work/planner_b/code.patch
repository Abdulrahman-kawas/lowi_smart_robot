diff --git a/spider-robot/body/src/spider_body/realtime.py b/spider-robot/body/src/spider_body/realtime.py
new file mode 100644
index 0000000..d729151
--- /dev/null
+++ b/spider-robot/body/src/spider_body/realtime.py
@@ -0,0 +1,59 @@
+"""Process-level isolation for the control loop. Failures degrade to a warning, never a crash.
+
+systemd sets CPUAffinity. This module does what must happen inside the process:
+
+  * shortens the GIL switch interval, so the MQTT thread cannot hold the loop for 5 ms
+  * optionally locks memory, so AI services under pressure cannot page out the loop
+  * optionally makes this thread SCHED_FIFO. SCHED_RESET_ON_FORK makes every thread created
+    afterwards (camera worker, ZeroMQ I/O) a normal one, so only the control thread is real-time
+"""
+
+from __future__ import annotations
+
+import ctypes
+import ctypes.util
+import logging
+import os
+import sys
+
+from .config import RealtimeCfg
+
+log = logging.getLogger(__name__)
+
+_MCL_CURRENT, _MCL_FUTURE = 1, 2
+
+
+def _lock_memory() -> str:
+    name = ctypes.util.find_library("c")
+    if name is None:
+        return "no libc"
+    libc = ctypes.CDLL(name, use_errno=True)
+    if not hasattr(libc, "mlockall"):
+        return "mlockall unavailable"
+    if libc.mlockall(_MCL_CURRENT | _MCL_FUTURE) != 0:
+        return f"mlockall failed: {os.strerror(ctypes.get_errno())}"
+    return "locked"
+
+
+def _set_fifo(priority: int) -> str:
+    fifo = getattr(os, "SCHED_FIFO", None)
+    if fifo is None or not hasattr(os, "sched_setscheduler"):
+        return "unsupported on this platform"
+    reset = getattr(os, "SCHED_RESET_ON_FORK", 0)
+    try:
+        os.sched_setscheduler(0, fifo | reset, os.sched_param(priority))
+    except OSError as exc:  # needs LimitRTPRIO in the unit; run on without it
+        return f"denied: {exc.strerror}"
+    return f"fifo:{priority}"
+
+
+def apply_realtime(cfg: RealtimeCfg) -> dict[str, str]:
+    """Apply the settings and report what really happened, for the startup log."""
+    sys.setswitchinterval(cfg.gil_switch_ms / 1000.0)
+    report = {"gil_switch_ms": str(cfg.gil_switch_ms)}
+    report["mlock"] = _lock_memory() if cfg.mlock else "off"
+    report["sched"] = _set_fifo(cfg.fifo_priority) if cfg.fifo_priority > 0 else "normal"
+    if hasattr(os, "sched_getaffinity"):
+        report["cpus"] = ",".join(map(str, sorted(os.sched_getaffinity(0))))
+    log.info("realtime settings: %s", report)
+    return report
diff --git a/spider-robot/body/src/spider_body/recorder.py b/spider-robot/body/src/spider_body/recorder.py
new file mode 100644
index 0000000..e61aa92
--- /dev/null
+++ b/spider-robot/body/src/spider_body/recorder.py
@@ -0,0 +1,215 @@
+"""spider-record: writes full-rate LiDAR and IMU to disk for a mapping job. Runs on cores 1-3.
+
+Format (SPLR v1), chosen so a crash loses at most the last buffer and the Pi needs no ROS:
+
+  file    b"SPLR\\x01" + uint32 header_len + JSON header
+  record  struct "<BdII" (kind, rx_time, hdr_len, payload_len) + hdr + payload
+          kind 1 = cloud: hdr "<dII" (stamp, id, n), payload float32[n*6] x,y,z,i,time,ring
+          kind 2 = imu:   hdr "<d" (stamp), payload float32[10] quat xyzw, gyro xyz, accel xyz
+
+infra/slam/rec2bag.py converts this to a ROS bag on the machine that runs SLAM.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import logging
+import os
+import shutil
+import struct
+import threading
+import time
+from pathlib import Path
+
+import yaml
+from spider_common.link import Link, MqttLink, MqttSettings
+from spider_common.protocol import RecordCommand, RecordStatus, Topics
+
+log = logging.getLogger("spider_record")
+
+MAGIC = b"SPLR\x01"
+RECORD = struct.Struct("<BdII")
+KINDS = {b"rawcloud": 1, b"rawimu": 2}
+CHUNK_BYTES = 256 * 1024 * 1024
+MIN_FREE_BYTES = 1024 * 1024 * 1024
+
+
+class Recorder:
+    def __init__(self, root: Path, robot_id: str, chunk_bytes: int = CHUNK_BYTES,
+                 min_free: int = MIN_FREE_BYTES, wall=time.time, monotonic=time.monotonic,
+                 free_bytes=None) -> None:
+        self.root, self.robot_id = root, robot_id
+        self.chunk_bytes, self.min_free = chunk_bytes, min_free
+        self.wall, self.monotonic = wall, monotonic
+        self._free = free_bytes or (lambda path: shutil.disk_usage(path).free)
+        self.job_id: str | None = None
+        self.deadline = 0.0
+        self.bytes_written = 0
+        self.records = 0
+        self.failure = ""
+        self._file = None
+        self._chunk = 0
+        self._chunk_size = 0
+        self._dir: Path | None = None
+
+    @property
+    def active(self) -> bool:
+        return self.job_id is not None
+
+    def start(self, job_id: str, max_s: float) -> None:
+        if self.active:
+            self.stop()
+        self._dir = self.root / job_id
+        self._dir.mkdir(parents=True, exist_ok=True)
+        self.job_id, self.deadline = job_id, self.monotonic() + max_s
+        self.bytes_written, self.records, self._chunk, self.failure = 0, 0, 0, ""
+        self._open_chunk()
+
+    def _open_chunk(self) -> None:
+        assert self._dir is not None
+        if self._file is not None:
+            self._file.close()
+        name = self._dir / f"chunk-{self._chunk:04d}.splr"
+        self._file = open(name, "wb", buffering=1024 * 1024)  # noqa: SIM115 - kept across chunks
+        head = json.dumps({"version": 1, "robot_id": self.robot_id, "job_id": self.job_id,
+                           "chunk": self._chunk, "created": self.wall()}).encode()
+        self._file.write(MAGIC + struct.pack("<I", len(head)) + head)
+        self._chunk_size = len(MAGIC) + 4 + len(head)
+        self._chunk += 1
+
+    def handle(self, parts: list[bytes]) -> bool:
+        """Write one multipart message. Returns False when the job has just ended."""
+        if not self.active:
+            return False
+        if self.monotonic() >= self.deadline:
+            self.stop()
+            return False
+        if self.records % 500 == 0 and self._free(self.root) < self.min_free:
+            self.failure = "disk nearly full"
+            self.stop()
+            return False
+        kind = KINDS.get(parts[0]) if len(parts) == 3 else None
+        if kind is None:
+            return True
+        hdr, payload = parts[1], parts[2]
+        size = RECORD.size + len(hdr) + len(payload)
+        if self._chunk_size + size > self.chunk_bytes:
+            self._open_chunk()
+        self._file.write(RECORD.pack(kind, self.wall(), len(hdr), len(payload)))
+        self._file.write(hdr)
+        self._file.write(payload)
+        self._chunk_size += size
+        self.bytes_written += size
+        self.records += 1
+        return True
+
+    def stop(self) -> None:
+        if self._file is not None:
+            self._file.flush()
+            os.fsync(self._file.fileno())
+            self._file.close()
+            self._file = None
+        self.last_job, self.job_id = self.job_id, None
+
+    def status(self, job_id: str | None = None) -> RecordStatus:
+        job = job_id or self.job_id or getattr(self, "last_job", None) or "none"
+        state = "recording" if self.active else ("failed" if self.failure else "done")
+        return RecordStatus(job_id=job, state=state, bytes_written=self.bytes_written,
+                            records=self.records, detail=self.failure)
+
+
+def capture(rec: Recorder, endpoint: str, stop: threading.Event) -> None:
+    """Blocking receive on a thread: far cheaper per message than the asyncio socket at 500 Hz.
+
+    The socket exists only during a job, so an idle recorder costs the LiDAR bridge nothing.
+    """
+    import zmq
+
+    sock = zmq.Context.instance().socket(zmq.SUB)
+    sock.setsockopt(zmq.RCVHWM, 2000)
+    sock.setsockopt(zmq.SUBSCRIBE, b"rawcloud")
+    sock.setsockopt(zmq.SUBSCRIBE, b"rawimu")
+    sock.connect(endpoint)
+    try:
+        while rec.active and not stop.is_set():
+            if sock.poll(500):
+                rec.handle(sock.recv_multipart())
+    finally:
+        sock.close(0)
+        if rec.active:
+            rec.stop()
+
+
+class Controller:
+    """One capture thread at a time, driven by commands from the broker."""
+
+    def __init__(self, rec: Recorder, link: Link, topics: Topics, endpoint: str) -> None:
+        self.rec, self.link, self.topics, self.endpoint = rec, link, topics, endpoint
+        self._stop = threading.Event()
+        self._task: asyncio.Task | None = None
+
+    def _report(self, job_id: str | None = None) -> None:
+        self.link.publish(self.topics.record_status, self.rec.status(job_id).model_dump_json(),
+                          qos=1)
+
+    async def _end_current(self) -> None:
+        if self._task is not None:
+            self._stop.set()
+            await self._task
+            self._task = None
+
+    async def _run_capture(self) -> None:
+        await asyncio.to_thread(capture, self.rec, self.endpoint, self._stop)
+        self._report()
+
+    async def handle(self, cmd: RecordCommand) -> None:
+        await self._end_current()
+        if cmd.action == "start":
+            self._stop = threading.Event()
+            self.rec.start(cmd.job_id, cmd.max_s)
+            self._task = asyncio.create_task(self._run_capture())
+        self._report(cmd.job_id)
+
+
+async def _commands(ctl: Controller, link: Link, topics: Topics) -> None:
+    async for msg in link.messages():
+        if msg.topic != topics.record_cmd:
+            continue
+        try:
+            cmd = RecordCommand.model_validate_json(msg.payload)
+        except ValueError:
+            log.warning("bad record command")
+            continue
+        await ctl.handle(cmd)
+
+
+async def _run(cfg: dict, root: Path) -> None:
+    robot_id = cfg["robot_id"]
+    topics = Topics(robot_id)
+    m = cfg["mqtt"]
+    secret = m.get("password_file")
+    password = Path(secret).read_text("utf-8").strip() if secret else None
+    link = MqttLink(MqttSettings(host=m["host"], port=m["port"], client_id="spider-record",
+                                 tls=False, username=m.get("username"), password=password,
+                                 reconnect_max_s=2),
+                    subscriptions=[topics.record_cmd])
+    await link.start()
+    endpoint = cfg.get("endpoint", "ipc:///tmp/spider_lidar.ipc")
+    await _commands(Controller(Recorder(root, robot_id), link, topics, endpoint), link, topics)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="spider-record")
+    parser.add_argument("--config", default="/etc/spider/record.yaml")
+    parser.add_argument("--root", default="/var/lib/spider/recordings")
+    args = parser.parse_args(argv)
+    logging.basicConfig(level="INFO")
+    cfg = yaml.safe_load(Path(args.config).read_text("utf-8"))
+    asyncio.run(_run(cfg, Path(args.root)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
