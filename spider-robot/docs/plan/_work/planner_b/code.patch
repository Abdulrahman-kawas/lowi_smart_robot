@@ -0,0 +1,69 @@
+"""Piper for normal speech, espeak-ng as the fallback that always works."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator
+
+
+class PiperTts:
+    name = "piper"
+
+    def __init__(self, model_path: str, voice=None) -> None:
+        if voice is None:
+            from piper import PiperVoice
+
+            voice = PiperVoice.load(model_path)
+        self.voice = voice
+        self.rate = int(voice.config.sample_rate)
+
+    async def stream(self, text: str) -> AsyncIterator[bytes]:
+        loop = asyncio.get_running_loop()
+        queue: asyncio.Queue[bytes | Exception | None] = asyncio.Queue()
+
+        def work() -> None:
+            try:
+                for chunk in self.voice.synthesize(text):
+                    loop.call_soon_threadsafe(queue.put_nowait, chunk.audio_int16_bytes)
+                loop.call_soon_threadsafe(queue.put_nowait, None)
+            except Exception as exc:  # reaches the caller, which falls back to espeak
+                loop.call_soon_threadsafe(queue.put_nowait, exc)
+
+        task = asyncio.create_task(asyncio.to_thread(work))
+        try:
+            while (item := await queue.get()) is not None:
+                if isinstance(item, Exception):
+                    raise item
+                yield item
+        finally:
+            await task
+
+    async def aclose(self) -> None:
+        return None
+
+
+def pcm_from_wav(wav: bytes) -> bytes:
+    """Skip the RIFF chunks. espeak-ng streams with sizes that cannot be trusted."""
+    index = wav.find(b"data")
+    return wav[index + 8:] if index >= 0 else b""
+
+
+class EspeakTts:
+    name = "espeak"
+    rate = 22050
+
+    def __init__(self, voice: str = "ar", binary: str = "espeak-ng") -> None:
+        self.voice, self.binary = voice, binary
+
+    async def stream(self, text: str) -> AsyncIterator[bytes]:
+        proc = await asyncio.create_subprocess_exec(
+            self.binary, "-v", self.voice, "--stdout", text,
+            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
+        )
+        out, _ = await proc.communicate()
+        if proc.returncode != 0:
+            raise RuntimeError("espeak-ng failed")
+        yield pcm_from_wav(out)
+
+    async def aclose(self) -> None:
+        return None
