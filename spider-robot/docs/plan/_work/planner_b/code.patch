--- /dev/null
+++ b/spider-robot/common/tests/test_contract.py
@@ -0,0 +1,105 @@
+"""Contract tests: the rules Pi and server rely on during a rolling update."""
+
+import json
+import logging
+
+import pytest
+from pydantic import ValidationError
+
+from spider_common.link import InMemoryHub
+from spider_common.protocol import (
+    PROTOCOL_VERSION,
+    AskReply,
+    AskRequest,
+    ConfirmChallenge,
+    ConfirmRequest,
+    EStopRelease,
+    GatewayStatus,
+    Move,
+    Posture,
+    RobotEvent,
+    RobotState,
+    SttRequest,
+    Topics,
+    parse_command,
+)
+from spider_common.telemetry import JsonFormatter, new_cid
+
+
+def test_commands_from_the_previous_build_still_parse():
+    # A server that has not been updated sends no cid or challenge fields.
+    old = '{"type":"move","v":2,"session":"s","seq":3,"ts":1.0,"vx":0.05,"duration_s":1.0}'
+    cmd = parse_command(old)
+    assert isinstance(cmd, Move) and cmd.cid == ""
+
+
+def test_unknown_event_kind_and_state_field_are_tolerated():
+    ev = RobotEvent.model_validate_json('{"robot_id":"r","kind":"from_the_future"}')
+    assert ev.kind == "from_the_future"
+    st = RobotState.model_validate_json('{"robot_id":"r","mode":"standing","new_field":1}')
+    assert st.mode == "standing"
+
+
+def test_commands_still_reject_unknown_fields():
+    with pytest.raises(ValidationError):
+        parse_command('{"type":"stop","surprise":1}')
+
+
+def test_confirm_flow_messages_roundtrip():
+    req = parse_command(ConfirmRequest(action="estop_release", request_id="r1").model_dump_json())
+    assert isinstance(req, ConfirmRequest)
+    rel = parse_command(EStopRelease(challenge="c1", frame_sha256="ab").model_dump_json())
+    assert isinstance(rel, EStopRelease) and rel.challenge == "c1"
+    pose = parse_command(Posture(posture="stand", challenge="c2").model_dump_json())
+    assert isinstance(pose, Posture) and pose.challenge == "c2"
+    ch = ConfirmChallenge(id="c", action="wake_from_limp", request_id="r", sha256="x", ttl_s=30)
+    ev = RobotEvent(robot_id="r", kind="challenge", detail=ch.model_dump_json())
+    assert ConfirmChallenge.model_validate_json(ev.detail).action == "wake_from_limp"
+
+
+def test_ask_reply_cannot_carry_an_action():
+    # Decision 7: vision and cloud answers are spoken only.
+    assert set(AskReply.model_fields) == {
+        "v", "cid", "ts", "ok", "text", "provider", "elapsed_ms", "error"
+    }
+
+
+def test_ask_and_stt_requests_are_bounded():
+    with pytest.raises(ValidationError):
+        AskRequest(cid="a", text="x" * 5000)
+    with pytest.raises(ValidationError):
+        AskRequest(cid="../bad", text="hi")
+    with pytest.raises(ValidationError):
+        SttRequest(cid="a", audio_b64="A" * 500_000)
+
+
+def test_gateway_status_schema():
+    st = GatewayStatus(robot_id="r", session="s")
+    assert json.loads(st.model_dump_json())["v"] == PROTOCOL_VERSION
+
+
+def test_new_topics_are_namespaced_per_robot():
+    t = Topics("r1")
+    assert t.gateway_status == "spider/r1/gw/status"
+    assert t.rpc_request("ask") == "spider/r1/rpc/ask/req"
+    assert t.rpc_reply("stt", "voice") == "spider/r1/rpc/stt/res/voice"
+
+
+async def test_retained_message_reaches_a_late_subscriber():
+    hub = InMemoryHub()
+    t = Topics("r")
+    pub = hub.endpoint([])
+    await pub.start()
+    pub.publish(t.gateway_status, b"x", qos=1, retain=True)
+    late = hub.endpoint([t.gateway_status])
+    await late.start()
+    assert late.inbox.queue.get_nowait().payload == b"x"
+
+
+def test_json_logs_carry_service_and_correlation_id():
+    fmt = JsonFormatter("spider-test")
+    rec = logging.LogRecord("x", logging.INFO, "f", 1, "hello %s", ("w",), None)
+    rec.cid = "abc"
+    out = json.loads(fmt.format(rec))
+    assert out["svc"] == "spider-test" and out["msg"] == "hello w" and out["cid"] == "abc"
+    assert len(new_cid()) == 12
diff --git a/spider-robot/common/tests/test_health.py b/spider-robot/common/tests/test_health.py
new file mode 100644
index 0000000..f296911
--- /dev/null
+++ b/spider-robot/common/tests/test_health.py
@@ -0,0 +1,41 @@
+import json
+
+from spider_common.health import (
+    collect,
+    parse_failed_units,
+    parse_meminfo,
+    parse_tailscale_path,
+    parse_throttled,
+)
+
+
+def test_meminfo():
+    text = "MemTotal: 4000000 kB\nMemAvailable: 2048000 kB\nSwapTotal: 1024 kB\nSwapFree: 0 kB\n"
+    assert parse_meminfo(text) == (2000.0, 1.0)
+
+
+def test_throttled():
+    assert parse_throttled("throttled=0x50005\n") == "0x50005"
+    assert parse_throttled(None) is None
+
+
+def test_failed_units_keep_only_ours():
+    text = "spider-voice.service loaded failed failed x\nsnapd.service loaded failed failed y\n"
+    assert parse_failed_units(text) == ["spider-voice.service"]
+
+
+def _status(**node):
+    return json.dumps({"Peer": {"k": {"HostName": "server", "Online": True, **node}}})
+
+
+def test_tailscale_paths():
+    assert parse_tailscale_path(_status(CurAddr="1.2.3.4:41641"), "server") == "direct"
+    assert parse_tailscale_path(_status(Relay="tok", CurAddr=""), "server") == "relay"
+    assert parse_tailscale_path(_status(Online=False), "server") == "none"
+    assert parse_tailscale_path(_status(), "other") == "none"
+    assert parse_tailscale_path(None, "server") is None
+
+
+def test_collect_runs_on_a_machine_without_the_pi_tools():
+    report = collect("test", "peer")
+    assert report.node == "test" and report.disk_free_mb is not None
