@@ -0,0 +1,42 @@
+"""Names in voice.yaml -> adapter objects. The only place that knows which adapters exist."""
+
+from __future__ import annotations
+
+from .adapters.audio import PlayerOut
+from .adapters.router import OllamaRouter
+from .adapters.stt_rpc import RpcStt
+from .adapters.tts import EspeakTts, PiperTts
+from .config import VoiceConfig
+from .rpc import RpcClient
+
+
+def make_stt(name: str | None, cfg: VoiceConfig, rpc: RpcClient):
+    if name is None:
+        return None
+    if name == "whisper_local":
+        from .adapters.stt_whisper import FasterWhisperStt
+
+        return FasterWhisperStt(cfg.stt.whisper)
+    if name == "whisper_server":
+        return RpcStt(rpc, cfg.stt.server_timeout_s, cfg.stt.whisper.initial_prompt)
+    raise ValueError(f"unknown STT adapter {name!r}")
+
+
+def make_tts(name: str | None, cfg: VoiceConfig):
+    if name is None:
+        return None
+    if name == "piper":
+        return PiperTts(cfg.tts.piper_model)
+    if name == "espeak":
+        return EspeakTts(cfg.tts.espeak_voice)
+    raise ValueError(f"unknown TTS adapter {name!r}")
+
+
+def make_router(cfg: VoiceConfig):
+    if cfg.router.kind == "ollama":
+        return OllamaRouter(cfg.router)
+    raise ValueError(f"unknown router {cfg.router.kind!r}")
+
+
+def make_audio_out(cfg: VoiceConfig) -> PlayerOut:
+    return PlayerOut(cfg.audio.player)
diff --git a/spider-robot/voice/src/spider_voice/grammar.py b/spider-robot/voice/src/spider_voice/grammar.py
new file mode 100644
index 0000000..00e60c3
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/grammar.py
@@ -0,0 +1,66 @@
+"""Deterministic phrases. A hit needs no model: no LLM delay, no chance of a hallucinated action.
+
+Stop words are matched on every transcript, even a negated one, because a false stop is safe.
+Motion phrases are refused after a negation ("don't walk") and fall through to the router.
+"""
+
+from __future__ import annotations
+
+from .normalize import normalize, within_one_edit
+
+_FUZZY_MIN_LEN = 4  # short words are too close to ordinary ones (وقف / وقت)
+
+
+def _norm(words: list[str]) -> frozenset[str]:
+    return frozenset(normalize(w) for w in words)
+
+
+STOP_WORDS = _norm(["قف", "وقف", "أوقف", "توقف", "ستوب", "خلاص", "stop", "halt"])
+ESTOP_WORDS = _norm(["طوارئ", "emergency"])
+NEGATIONS = _norm(["لا", "ما", "مش", "مو", "بلاش", "don't", "dont", "not"])
+
+_PHRASES: dict[str, list[str]] = {
+    "forward": ["امشي", "امش", "قدام", "لقدام", "تقدم", "روح قدام", "forward"],
+    "back": ["ارجع", "لورا", "رجوع", "ارجع لورا", "back"],
+    "left": ["يسار", "شمال", "لف يسار", "لف شمال", "left"],
+    "right": ["يمين", "لف يمين", "right"],
+    "look": ["شوف", "انظر", "بص", "شو قدامك", "look"],
+    "stand": ["قوم", "انهض", "stand"],
+    "sit": ["اقعد", "اجلس", "sit"],
+}
+PHRASES: dict[tuple[str, ...], str] = {
+    tuple(normalize(p).split()): act for act, items in _PHRASES.items() for p in items
+}
+_ORDERED = sorted(PHRASES, key=len, reverse=True)
+_MAX_WORDS = 7  # a long sentence that happens to contain "قدام" is not a command
+
+
+def _hit(token: str, words: frozenset[str]) -> bool:
+    if token in words:
+        return True
+    return len(token) >= _FUZZY_MIN_LEN and any(
+        len(w) >= _FUZZY_MIN_LEN and within_one_edit(token, w) for w in words
+    )
+
+
+def is_stop(toks: list[str]) -> bool:
+    return any(_hit(t, STOP_WORDS) for t in toks)
+
+
+def is_estop(toks: list[str]) -> bool:
+    return any(_hit(t, ESTOP_WORDS) for t in toks)
+
+
+def contains_stop_word(text: str) -> bool:
+    toks = normalize(text).split()
+    return is_stop(toks) or is_estop(toks)
+
+
+def match_command(toks: list[str]) -> str | None:
+    if not toks or len(toks) > _MAX_WORDS or any(t in NEGATIONS for t in toks):
+        return None  # a negation anywhere: let the router read the whole sentence
+    for phrase in _ORDERED:
+        for start in range(len(toks) - len(phrase) + 1):
+            if tuple(toks[start:start + len(phrase)]) == phrase:
+                return PHRASES[phrase]
+    return None
diff --git a/spider-robot/voice/src/spider_voice/interfaces.py b/spider-robot/voice/src/spider_voice/interfaces.py
new file mode 100644
index 0000000..898cdcd
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/interfaces.py
@@ -0,0 +1,59 @@
+"""The small interfaces everything else depends on. Adding a model means one adapter plus config."""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator, Callable
+from dataclasses import dataclass
+from typing import Protocol
+
+ACTS = ("forward", "back", "left", "right", "stop", "look", "ask", "none")
+
+
+@dataclass(frozen=True)
+class Transcript:
+    text: str
+    confidence: float  # 0..1
+    provider: str
+    elapsed_ms: float = 0.0
+
+
+@dataclass(frozen=True)
+class Decision:
+    act: str
+    say: str
+    provider: str
+    elapsed_ms: float = 0.0
+    first_act_ms: float | None = None
+
+
+class SpeechToText(Protocol):
+    name: str
+
+    async def transcribe(self, pcm: bytes, rate: int, cid: str) -> Transcript: ...
+
+    async def aclose(self) -> None: ...
+
+
+class TextToSpeech(Protocol):
+    name: str
+    rate: int
+
+    def stream(self, text: str) -> AsyncIterator[bytes]: ...
+
+    async def aclose(self) -> None: ...
+
+
+class Router(Protocol):
+    name: str
+
+    async def decide(self, text: str, on_act: Callable[[str], None] | None = None) -> Decision: ...
+
+    async def aclose(self) -> None: ...
+
+
+class AudioOut(Protocol):
+    async def play(
+        self, chunks: AsyncIterator[bytes], rate: int, on_first: Callable[[], None] | None = None
+    ) -> None: ...
+
+    def stop(self) -> None: ...
diff --git a/spider-robot/voice/src/spider_voice/main.py b/spider-robot/voice/src/spider_voice/main.py
new file mode 100644
index 0000000..ac7c117
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/main.py
@@ -0,0 +1,57 @@
+"""spider-voice entry point."""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+from pathlib import Path
+
+from spider_common.link import MqttLink, MqttSettings
+from spider_common.telemetry import setup_logging
+
+from . import factory
+from .adapters.audio import pyaudio_frames
+from .config import VoiceConfig, load_config
+from .pipeline import VoicePipeline
+from .rpc import RpcClient
+from .vad import make_classifier
+
+
+def build_link(cfg: VoiceConfig) -> MqttLink:
+    m = cfg.mqtt
+    password = Path(m.password_file).read_text("utf-8").strip() if m.password_file else None
+    return MqttLink(
+        MqttSettings(host=m.host, port=m.port, client_id="spider-voice", tls=m.tls,
+                     username=m.username, password=password, reconnect_max_s=2),
+        subscriptions=VoicePipeline.subscriptions(cfg.robot_id),
+    )
+
+
+async def _run(cfg: VoiceConfig) -> None:
+    link = build_link(cfg)
+    rpc = RpcClient(link, cfg.robot_id)
+    pipeline = VoicePipeline(
+        cfg, link, factory.make_stt(cfg.stt.primary, cfg, rpc),
+        factory.make_tts(cfg.tts.primary, cfg), factory.make_router(cfg),
+        factory.make_audio_out(cfg), make_classifier(cfg.vad.aggressiveness),
+        fallback_stt=factory.make_stt(cfg.stt.fallback, cfg, rpc),
+        escalate_stt=factory.make_stt(cfg.stt.escalate, cfg, rpc),
+        fallback_tts=factory.make_tts(cfg.tts.fallback, cfg), rpc=rpc,
+    )
+    await link.start()
+    await pipeline.prepare()
+    await pipeline.run(pyaudio_frames(cfg.audio.rate, cfg.audio.frame_ms, cfg.audio.input_device))
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="spider-voice")
+    parser.add_argument("--config", default="/etc/spider/voice.yaml")
+    parser.add_argument("--log-level", default="INFO")
+    args = parser.parse_args(argv)
+    setup_logging("spider-voice", args.log_level)
+    asyncio.run(_run(load_config(args.config)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/spider-robot/voice/src/spider_voice/normalize.py b/spider-robot/voice/src/spider_voice/normalize.py
new file mode 100644
index 0000000..3db53ed
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/normalize.py
@@ -0,0 +1,36 @@
+"""Arabic text normalisation shared by stop words, grammar and the wake phrase."""
+
+from __future__ import annotations
+
+import re
+
+_DIACRITICS = re.compile(r"[ؐ-ًؚ-ٰٟۖ-ۭ]")
+_NON_WORD = re.compile(r"[^\w\s]|_", re.UNICODE)
+_MAP = str.maketrans({
+    "أ": "ا", "إ": "ا", "آ": "ا", "ى": "ي", "ة": "ه", "ؤ": "و", "ئ": "ي", "ء": "",
+    "ـ": "", "گ": "ك", "پ": "ب", "چ": "ج", "ڤ": "ف",
+})
+
+
+def normalize(text: str) -> str:
+    text = _DIACRITICS.sub("", text).translate(_MAP).lower()
+    return " ".join(_NON_WORD.sub(" ", text).split())
+
+
+def tokens(text: str) -> list[str]:
+    return normalize(text).split()
+
+
+def within_one_edit(a: str, b: str) -> bool:
+    if a == b:
+        return True
+    if abs(len(a) - len(b)) > 1:
+        return False
+    if len(a) > len(b):
+        a, b = b, a
+    i = 0
+    while i < len(a) and a[i] == b[i]:
+        i += 1
+    if len(a) == len(b):
+        return a[i + 1:] == b[i + 1:]
+    return a[i:] == b[i + 1:]
diff --git a/spider-robot/voice/src/spider_voice/pipeline.py b/spider-robot/voice/src/spider_voice/pipeline.py
new file mode 100644
index 0000000..c280bae
--- /dev/null
+++ b/spider-robot/voice/src/spider_voice/pipeline.py
@@ -0,0 +1,432 @@
+"""The voice loop: audio frames in, commands to the gateway and speech out.
+
+  speech onset, robot moving  -> Stop at once, before any model has run
+  end of speech               -> STT -> stop words -> attention -> grammar -> router
+  act and say run in parallel; vision and hard questions come back as speech only
+
+The Pi has no spare cores for this loop to block: models run on worker threads or in other
+processes, and one utterance is processed at a time.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import itertools
+import logging
+import re
+import time
+import uuid
+from collections import deque
+from collections.abc import AsyncIterator, Callable
+from dataclasses import dataclass, field
+
+from spider_common.link import Link
+from spider_common.protocol import (
+    AskReply,
+    AskRequest,
+    Command,
+    EStop,
+    Heartbeat,
+    Move,
+    RobotEvent,
+    RobotState,
+    Stop,
+    Topics,
+    VoiceTrace,
+)
+from spider_common.telemetry import new_cid
+
+from . import grammar
+from .actions import MOTION_ACTS, to_command
+from .attention import Attention
+from .config import VoiceConfig
+from .interfaces import Decision, Router, SpeechToText, TextToSpeech, Transcript
+from .normalize import tokens
+from .rpc import RpcClient
+from .vad import FrameClassifier, Segmenter, SpeechEnd, SpeechStart
+
+log = logging.getLogger(__name__)
+
+HEARTBEAT_S = 0.25
+STATE_FRESH_S = 1.0
+_CLAUSE = re.compile(r"[،,.!؟?؛;]")
+
+
+def clean_say(text: str, max_chars: int) -> str:
+    """Own speech never contains a stop word, so hearing itself can never stop the robot."""
+    words = [w for w in text.split() if not grammar.contains_stop_word(w)]
+    out = " ".join(words)
+    return out[:max_chars].rsplit(" ", 1)[0] if len(out) > max_chars else out
+
+
+def short_clause(text: str, max_chars: int) -> str:
+    return clean_say(_CLAUSE.split(text, maxsplit=1)[0].strip(), max_chars)
+
+
+@dataclass
+class _Trace:
+    cid: str
+    t_end: float
+    path: str = "ignored"
+    act: str = "none"
+    text: str = ""
+    stt_provider: str = ""
+    stages: dict[str, float] = field(default_factory=dict)
+    published: bool = False
+
+
+class VoicePipeline:
+    def __init__(
+        self, cfg: VoiceConfig, link: Link, stt: SpeechToText, tts: TextToSpeech, router: Router,
+        audio_out, classifier: FrameClassifier, *, fallback_stt: SpeechToText | None = None,
+        escalate_stt: SpeechToText | None = None, fallback_tts: TextToSpeech | None = None,
+        rpc: RpcClient | None = None, clock: Callable[[], float] = time.monotonic,
+        wall: Callable[[], float] = time.time,
+    ) -> None:
+        self.cfg, self.link = cfg, link
+        self.stt, self.fallback_stt, self.escalate_stt = stt, fallback_stt, escalate_stt
+        self.tts, self.fallback_tts, self.router, self.out = tts, fallback_tts, router, audio_out
+        self.clock, self.wall = clock, wall
+        self.topics = Topics(cfg.robot_id)
+        self.rpc = rpc or RpcClient(link, cfg.robot_id)
+        self.segmenter = Segmenter(cfg.vad, classifier, cfg.audio.rate, cfg.audio.frame_ms)
+        self.attention = Attention(cfg.wake, clock)
+        self.session = uuid.uuid4().hex[:12]
+        self._seq = itertools.count(1)
+        self._state: RobotState | None = None
+        self._state_rx = 0.0
+        self._motion_until = 0.0
+        self._speaking = False
+        self._deaf_until = 0.0
+        self._last_pre_stop = -1e9
+        self._queue: deque[tuple[SpeechEnd, str, bool]] = deque(maxlen=2)
+        self._wake = asyncio.Event()
+        self._cid_for_speech = ""
+        self._deaf_at_start = False
+        self._tasks: set[asyncio.Task] = set()
+        self._ask_task: asyncio.Task | None = None
+        self.canned: dict[str, tuple[bytes, int]] = {}
+        self.pre_stops = 0
+        self.dropped = 0
+
+    @staticmethod
+    def subscriptions(robot_id: str) -> list[str]:
+        t = Topics(robot_id)
+        return [t.state, t.source_event("voice"), t.rpc_reply("ask", "voice"),
+                t.rpc_reply("stt", "voice")]
+
+    # ------------------------------------------------------------------ commands
+    def _send(self, cmd: Command, cid: str) -> int:
+        seq = next(self._seq)
+        cmd = cmd.model_copy(update={
+            "seq": seq, "session": self.session, "ts": self.wall(), "cid": cid[:32]
+        })
+        qos = 0 if isinstance(cmd, Move) else 1
+        self.link.publish(self.topics.request("voice"), cmd.model_dump_json(), qos=qos)
+        if isinstance(cmd, Move):
+            self._motion_until = self.clock() + cmd.duration_s
+        elif isinstance(cmd, (Stop, EStop)):
+            self._motion_until = 0.0
+        return seq
+
+    def _dispatch(self, act: str, trace: _Trace) -> None:
+        cmd = to_command(act, self.cfg.motion)
+        if cmd is None:
+            return
+        self._send(cmd, trace.cid)
+        trace.stages["command"] = self._since(trace)
+
+    def _since(self, trace: _Trace) -> float:
+        return round((self.clock() - trace.t_end) * 1000, 1)
+
+    # ------------------------------------------------------------------ robot state
+    def _moving(self) -> bool:
+        now = self.clock()
+        if now < self._motion_until:
+            return True
+        st = self._state
+        if st is None or now - self._state_rx > STATE_FRESH_S:
+            return False
+        return st.mode == "walking" or abs(st.vx) + abs(st.vy) + abs(st.wz) > 1e-3
+
+    def _deaf(self) -> bool:
+        return self._speaking or self.clock() < self._deaf_until
+
+    # ------------------------------------------------------------------ audio
+    def on_frame(self, frame: bytes) -> None:
+        for event in self.segmenter.feed(frame, self.clock()):
+            if isinstance(event, SpeechStart):
+                self._on_speech_start()
+            elif isinstance(event, SpeechEnd):
+                self._on_speech_end(event)
+
+    def _on_speech_start(self) -> None:
+        self._cid_for_speech = new_cid()
+        self._deaf_at_start = self._deaf()
+        c = self.cfg.pre_stop
+        now = self.clock()
+        if (c.enabled and not self._deaf() and self._moving()
+                and now - self._last_pre_stop >= c.cooldown_s):
+            self._last_pre_stop = now
+            self.pre_stops += 1
+            self._send(Stop(), self._cid_for_speech)  # before any model has run
+            log.info("speech while moving: stopped", extra={"cid": self._cid_for_speech})
+
+    def _on_speech_end(self, segment: SpeechEnd) -> None:
+        if len(self._queue) == self._queue.maxlen:
+            self.dropped += 1
+        deaf = self._deaf_at_start or self._deaf()  # either end overlapping our own voice counts
+        self._queue.append((segment, self._cid_for_speech or new_cid(), deaf))
+        self._wake.set()
+
+    # ------------------------------------------------------------------ one utterance
+    async def _transcribe(self, seg: SpeechEnd, cid: str) -> Transcript | None:
+        rate = self.cfg.audio.rate
+        try:
+            return await asyncio.wait_for(self.stt.transcribe(seg.pcm, rate, cid),
+                                          self.cfg.stt.deadline_s)
+        except Exception as exc:
+            log.warning("primary STT failed: %r", exc, extra={"cid": cid})
+        if self.fallback_stt is None:
+            return None
+        try:
+            return await self.fallback_stt.transcribe(seg.pcm, rate, cid)
+        except Exception as exc:
+            log.warning("fallback STT failed: %r", exc, extra={"cid": cid})
+            return None
+
+    async def _escalate(self, seg: SpeechEnd, heard: Transcript, cid: str) -> Transcript:
+        if self.escalate_stt is None or heard.confidence >= self.cfg.stt.escalate_below:
+            return heard
+        try:
+            better = await self.escalate_stt.transcribe(seg.pcm, self.cfg.audio.rate, cid)
+        except Exception as exc:
+            log.info("STT escalation failed: %r", exc, extra={"cid": cid})
+            return heard
+        return better if better.text.strip() else heard
+
+    def _stop_now(self, toks: list[str], trace: _Trace) -> bool:
+        estop = grammar.is_estop(toks)
+        if not estop and not grammar.is_stop(toks):
+            return False
+        self._send(EStop() if estop else Stop(), trace.cid)
+        trace.stages["command"] = self._since(trace)
+        trace.path, trace.act = "stop", "estop" if estop else "stop"
+        self.out.stop()
+        return True
+
+    async def process(self, seg: SpeechEnd, cid: str, deaf: bool) -> None:
+        trace = _Trace(cid, seg.t_end)
+        heard = await self._transcribe(seg, cid)
+        trace.stages["stt"] = self._since(trace)
+        if heard is None or not heard.text.strip():
+            trace.path = "error" if heard is None else "ignored"
+            self._publish(trace)
+            return
+        trace.text, trace.stt_provider = heard.text, heard.provider
+        toks = tokens(heard.text)
+        if self._stop_now(toks, trace):
+            self._say(self.cfg.phrases.stopped, trace)
+            return
+        if deaf:  # most likely the robot's own voice
+            self._publish(trace)
+            return
+        accepted, rest = self.attention.admit(toks)
+        if not accepted:
+            self._publish(trace)
+            return
+        act = grammar.match_command(rest)
+        if act is None:
+            heard = await self._escalate(seg, heard, cid)
+            trace.text, trace.stt_provider = heard.text, heard.provider
+            toks = tokens(heard.text)
+            if self._stop_now(toks, trace):
+                self._say(self.cfg.phrases.stopped, trace)
+                return
+            _, rest = self.attention.admit(toks)
+            act = grammar.match_command(rest)
+        if act is not None:
+            await self._run_grammar(act, heard.text, trace)
+        else:
+            await self._run_router(" ".join(rest) or heard.text, trace)
+
+    async def _run_grammar(self, act: str, text: str, trace: _Trace) -> None:
+        trace.path, trace.act = "grammar", act
+        if act == "look":
+            self._dispatch(act, trace)
+            self._say(self.cfg.phrases.filler, trace)
+            self._start_ask(text, True, trace.cid)
+            return
+        self._dispatch(act, trace)
+        self._say(self.cfg.phrases.ok, trace)
+
+    async def _run_router(self, text: str, trace: _Trace) -> None:
+        trace.path = "router"
+        fired: list[str] = []
+
+        def early(act: str) -> None:
+            if act in MOTION_ACTS or act == "stop":
+                fired.append(act)
+                self._dispatch(act, trace)
+                trace.stages["router_first_act"] = self._since(trace)
+
+        try:
+            decision: Decision = await self.router.decide(text, early)
+        except Exception as exc:
+            log.warning("router failed: %r", exc, extra={"cid": trace.cid})
+            trace.path = "error"
+            self._say(self.cfg.phrases.not_understood, trace)
+            return
+        trace.stages["router"] = self._since(trace)
+        trace.act = decision.act
+        if decision.act in MOTION_ACTS or decision.act == "stop":
+            if decision.act not in fired:  # the stream ended before the act could be read early
+                self._dispatch(decision.act, trace)
+            say = short_clause(decision.say, self.cfg.motion.say_max_chars)
+            self._say(say or self.cfg.phrases.ok, trace)
+        elif decision.act in ("look", "ask"):
+            trace.path = "escalate"
+            self._say(self.cfg.phrases.filler, trace)
+            self._start_ask(text, decision.act == "look", trace.cid)
+        else:
+            say = clean_say(decision.say, self.cfg.router.say_max_chars)
+            self._say(say or self.cfg.phrases.not_understood, trace)
+
+    # ------------------------------------------------------------------ escalation
+    def _start_ask(self, text: str, need_image: bool, cid: str) -> None:
+        if self._ask_task is not None:
+            self._ask_task.cancel()
+        self._ask_task = self._spawn(self._ask(text, need_image, cid))
+
+    async def _ask(self, text: str, need_image: bool, cid: str) -> None:
+        request = AskRequest(cid=cid, text=text[:2000], need_image=need_image,
+                             deadline_s=min(self.cfg.ask.timeout_s, 120.0))
+        answer = self.cfg.phrases.no_answer
+        try:
+            raw = await self.rpc.call("ask", cid, request.model_dump_json(), self.cfg.ask.timeout_s)
+            reply = AskReply.model_validate_json(raw)
+            if reply.ok and reply.text.strip():
+                answer = reply.text
+        except (TimeoutError, ConnectionError, ValueError) as exc:
+            log.info("ask failed: %r", exc, extra={"cid": cid})
+        if self._moving():  # long speech while moving would leave the robot deaf
+            answer = short_clause(answer, self.cfg.motion.say_max_chars)
+        self._say(clean_say(answer, 600), _Trace(cid, self.clock(), path="escalate"))
+
+    # ------------------------------------------------------------------ speech
+    def _say(self, text: str, trace: _Trace) -> None:
+        if not text:
+            self._publish(trace)
+            return
+        self._spawn(self._speak(text, trace))
+
+    async def _chunks(self, text: str) -> tuple[AsyncIterator[bytes], int]:
+        if text in self.canned:
+            pcm, rate = self.canned[text]
+
+            async def once() -> AsyncIterator[bytes]:
+                yield pcm
+
+            return once(), rate
+        return self.tts.stream(text), self.tts.rate
+
+    async def _speak(self, text: str, trace: _Trace) -> None:
+        self.out.stop()
+        self._speaking = True
+        def first() -> None:
+            trace.stages["first_audio"] = self._since(trace)
+
+        try:
+            chunks, rate = await self._chunks(text)
+            await self.out.play(chunks, rate, on_first=first)
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            log.warning("TTS failed: %r", exc, extra={"cid": trace.cid})
+            if self.fallback_tts is not None:
+                with contextlib.suppress(Exception):
+                    await self.out.play(self.fallback_tts.stream(text), self.fallback_tts.rate,
+                                        on_first=first)
+        finally:
+            self._speaking = False
+            self._deaf_until = self.clock() + self.cfg.tts_tail_ms / 1000.0
+            self._publish(trace)
+
+    def _publish(self, trace: _Trace) -> None:
+        if trace.published:
+            return
+        trace.published = True
+        out = VoiceTrace(robot_id=self.cfg.robot_id, cid=trace.cid, path=trace.path, act=trace.act,
+                         text=trace.text[:200], stt_provider=trace.stt_provider,
+                         stages_ms=trace.stages)
+        self.link.publish(self.topics.voice_trace, out.model_dump_json())
+        log.info("utterance", extra={"cid": trace.cid, "path": trace.path, "act": trace.act,
+                                     "stages_ms": trace.stages})
+
+    def _spawn(self, coro) -> asyncio.Task:
+        task = asyncio.create_task(coro)
+        self._tasks.add(task)
+        task.add_done_callback(self._tasks.discard)
+        return task
+
+    async def prepare(self) -> None:
+        """Pre-render the fixed phrases, so an acknowledgement needs no synthesis."""
+        p = self.cfg.phrases
+        for text in (p.ok, p.stopped, p.filler, p.not_understood, p.no_answer):
+            try:
+                pcm = b"".join([c async for c in self.tts.stream(text)])
+                self.canned[text] = (pcm, self.tts.rate)
+            except Exception as exc:
+                log.warning("could not pre-render %r: %r", text, exc)
+        try:  # loads the model and fills the prompt cache before anyone speaks
+            await self.router.decide("مرحبا")
+        except Exception as exc:
+            log.warning("router warm-up failed: %r", exc)
+
+    # ------------------------------------------------------------------ loops
+    def on_message(self, topic: str, payload: bytes) -> None:
+        if topic == self.topics.state:
+            self._state = RobotState.model_validate_json(payload)
+            self._state_rx = self.clock()
+        elif topic == self.topics.source_event("voice"):
+            event = RobotEvent.model_validate_json(payload)
+            if event.kind in ("obstacle_stop", "tilt", "fallen", "preempted", "estop"):
+                self._motion_until = 0.0
+        elif topic in self.rpc.reply_topics():
+            self.rpc.on_reply(self._reply_cid(payload), payload)
+
+    @staticmethod
+    def _reply_cid(payload: bytes) -> str:
+        return AskReply.model_validate_json(payload).cid
+
+    async def _pump(self) -> None:
+        async for msg in self.link.messages():
+            try:
+                self.on_message(msg.topic, msg.payload)
+            except Exception:
+                log.exception("bad message on %s", msg.topic)
+
+    async def _heartbeats(self) -> None:
+        while True:
+            self.link.publish(self.topics.request("voice"),
+                              Heartbeat(ts=self.wall(), session=self.session).model_dump_json())
+            await asyncio.sleep(HEARTBEAT_S)
+
+    async def _audio(self, frames: AsyncIterator[bytes]) -> None:
+        async for frame in frames:
+            self.on_frame(frame)
+
+    async def _worker(self) -> None:
+        while True:
+            await self._wake.wait()
+            while self._queue:
+                seg, cid, deaf = self._queue.popleft()
+                try:
+                    await self.process(seg, cid, deaf)
+                except Exception:
+                    log.exception("utterance failed", extra={"cid": cid})
+            self._wake.clear()
+
+    async def run(self, frames: AsyncIterator[bytes]) -> None:
+        await asyncio.gather(self._pump(), self._heartbeats(), self._worker(), self._audio(frames))
