+"""voice.yaml. Every model is chosen here; moving one to another machine is a config change."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Literal
+
+import yaml
+from pydantic import BaseModel, ConfigDict, Field
+
+
+class _M(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+
+class MqttCfg(_M):
+    host: str = "127.0.0.1"
+    port: int = 1883
+    tls: bool = False
+    username: str | None = None
+    password_file: str | None = None
+
+
+class AudioCfg(_M):
+    backend: Literal["pyaudio", "none"] = "pyaudio"
+    input_device: int | None = None
+    rate: Literal[16000] = 16000
+    frame_ms: Literal[10, 20, 30] = 20
+    player: list[str] = Field(default_factory=lambda: ["aplay", "-q"])
+
+
+class VadCfg(_M):
+    aggressiveness: int = Field(2, ge=0, le=3)
+    start_ms: int = 100  # continuous speech before SpeechStart
+    hang_ms: int = 300  # silence before SpeechEnd
+    min_speech_ms: int = 200
+    max_speech_ms: int = 8000
+    preroll_ms: int = 300
+    min_rms_dbfs: float = -45.0  # frames quieter than this are never speech
+
+
+class WhisperCfg(_M):
+    model: str = "tiny"
+    compute_type: str = "int8"
+    cpu_threads: int = 3
+    language: str = "ar"
+    beam_size: int = 1
+    download_root: str | None = None
+    # Biases the decoder toward the words that matter. Keep it short.
+    initial_prompt: str = "قف، وقف، امشي، ارجع، يمين، يسار، شوف، اقعد، قوم."
+
+
+class SttCfg(_M):
+    primary: str = "whisper_local"
+    fallback: str | None = None
+    escalate: str | None = "whisper_server"
+    deadline_s: float = 8.0  # primary gets this long before the fallback is tried
+    escalate_below: float = 0.45  # confidence under which a grammar miss goes to the server
+    server_timeout_s: float = 4.0
+    whisper: WhisperCfg = Field(default_factory=WhisperCfg)
+
+
+class TtsCfg(_M):
+    primary: str = "piper"
+    fallback: str | None = "espeak"
+    piper_model: str = "/opt/spider/models/ar_JO-kareem-low.onnx"
+    espeak_voice: str = "ar"
+
+
+class RouterCfg(_M):
+    kind: str = "ollama"
+    url: str = "http://127.0.0.1:11434"
+    model: str = "hf.co/LiquidAI/LFM2.5-350M-GGUF:Q4_K_M"
+    temperature: float = Field(0.1, ge=0.1, le=0.2)
+    num_predict: int = 80  # see plan: 60 chars of Arabic is at most about 56 tokens with the JSON
+    num_thread: int = 3
+    timeout_s: float = 10.0
+    say_max_chars: int = 60
+
+
+class MotionCfg(_M):
+    speed_mps: float = 0.08
+    turn_rps: float = 0.4
+    forward_s: float = 2.0
+    back_s: float = 1.5
+    turn_s: float = 1.5
+    gait: Literal["tripod", "ripple", "wave"] = "tripod"
+    say_max_chars: int = 30  # while moving, speech stays short so the deaf window stays short
+
+
+class PreStopCfg(_M):
+    enabled: bool = True
+    cooldown_s: float = 1.0
+
+
+class WakeCfg(_M):
+    mode: Literal["phrase", "always"] = "phrase"
+    words: list[str] = Field(default_factory=lambda: ["عنكبوت", "سبايدر", "spider"])
+    window_s: float = 10.0
+
+
+class AskCfg(_M):
+    timeout_s: float = 45.0
+
+
+class PhrasesCfg(_M):
+    ok: str = "حاضر"
+    stopped: str = "وقفت"
+    filler: str = "لحظة أشوف"
+    not_understood: str = "ما فهمت"
+    no_answer: str = "ما قدرت أجيب"
+
+
+class VoiceConfig(_M):
+    robot_id: str = "spider-01"
+    mqtt: MqttCfg = Field(default_factory=MqttCfg)
+    audio: AudioCfg = Field(default_factory=AudioCfg)
+    vad: VadCfg = Field(default_factory=VadCfg)
+    stt: SttCfg = Field(default_factory=SttCfg)
+    tts: TtsCfg = Field(default_factory=TtsCfg)
+    router: RouterCfg = Field(default_factory=RouterCfg)
+    motion: MotionCfg = Field(default_factory=MotionCfg)
+    pre_stop: PreStopCfg = Field(default_factory=PreStopCfg)
+    wake: WakeCfg = Field(default_factory=WakeCfg)
+    ask: AskCfg = Field(default_factory=AskCfg)
+    phrases: PhrasesCfg = Field(default_factory=PhrasesCfg)
+    tts_tail_ms: int = 250  # microphone stays deaf this long after playback ends
+
+
+def load_config(path: str | Path) -> VoiceConfig:
+    return VoiceConfig.model_validate(yaml.safe_load(Path(path).read_text("utf-8")) or {})
diff --git a/spider-robot/voice/src/spider_voice/factory.py b/spider-robot/voice/src/spider_voice/factory.py
