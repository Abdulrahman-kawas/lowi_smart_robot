@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# Runs on the worker every minute. Stops the instance after IDLE_S without activity or MAX_S of
+# uptime. It lives on the instance, so it fires even if the link home is dead.
+set -euo pipefail
+IDLE_S="${IDLE_S:-900}"
+MAX_S="${MAX_S:-14400}"
+MARK=/var/lib/spider-job/last_activity
+mkdir -p "$(dirname "$MARK")"
+uptime_s="$(cut -d. -f1 /proc/uptime)"
+if (( uptime_s >= MAX_S )); then
+  logger -t spider-self-stop "hard limit reached after ${uptime_s}s"
+  shutdown -h now
+  exit 0
+fi
+[[ -f "$MARK" ]] || touch "$MARK"
+idle_s=$(( $(date +%s) - $(stat -c %Y "$MARK") ))
+if pgrep -f 'run_slam.sh|rsync' >/dev/null; then
+  touch "$MARK"
+elif (( idle_s >= IDLE_S )); then
+  logger -t spider-self-stop "idle for ${idle_s}s"
+  shutdown -h now
+fi
