@@ -0,0 +1,51 @@
+"""faster-whisper on this machine. Inference runs on one worker thread, off the event loop."""
+
+from __future__ import annotations
+
+import asyncio
+import math
+import time
+from concurrent.futures import ThreadPoolExecutor
+
+import numpy as np
+
+from ..config import WhisperCfg
+from ..interfaces import Transcript
+
+
+class FasterWhisperStt:
+    name = "whisper_local"
+
+    def __init__(self, cfg: WhisperCfg, model=None) -> None:
+        self.cfg = cfg
+        if model is None:
+            from faster_whisper import WhisperModel
+
+            model = WhisperModel(cfg.model, device="cpu", compute_type=cfg.compute_type,
+                                 cpu_threads=cfg.cpu_threads, num_workers=1,
+                                 download_root=cfg.download_root)
+        self.model = model
+        self._pool = ThreadPoolExecutor(1, thread_name_prefix="stt")
+
+    def _run(self, pcm: bytes) -> tuple[str, float]:
+        audio = np.frombuffer(pcm, dtype="<i2").astype(np.float32) / 32768.0
+        segments, _info = self.model.transcribe(
+            audio, language=self.cfg.language, beam_size=self.cfg.beam_size, best_of=1,
+            temperature=0.0, condition_on_previous_text=False, without_timestamps=True,
+            vad_filter=False, initial_prompt=self.cfg.initial_prompt,
+        )
+        parts = list(segments)
+        text = " ".join(s.text.strip() for s in parts).strip()
+        if not parts:
+            return "", 0.0
+        mean = sum(s.avg_logprob for s in parts) / len(parts)
+        return text, min(1.0, math.exp(mean))
+
+    async def transcribe(self, pcm: bytes, rate: int, cid: str) -> Transcript:
+        started = time.perf_counter()
+        loop = asyncio.get_running_loop()
+        text, confidence = await loop.run_in_executor(self._pool, self._run, pcm)
+        return Transcript(text, confidence, self.name, (time.perf_counter() - started) * 1000)
+
+    async def aclose(self) -> None:
+        self._pool.shutdown(wait=False, cancel_futures=True)
diff --git a/spider-robot/voice/src/spider_voice/adapters/tts.py b/spider-robot/voice/src/spider_voice/adapters/tts.py
