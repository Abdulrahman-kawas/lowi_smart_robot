# /etc/spider/gateway.env (mode 640, owner spider). The gateway reaches the Pi's own broker on the
# loopback listener, which needs no certificate and no correct clock.
SG_ROBOT_ID=spider-01
SG_MQTT_HOST=127.0.0.1
SG_MQTT_PORT=1883
SG_MQTT_TLS=0
SG_MQTT_USERNAME=spider-gateway
SG_MQTT_PASSWORD_FILE=/etc/spider/secrets/spider-gateway.mqtt
SG_SOURCE_TIMEOUT_S=1.5
SG_STOP_HOLDOFF_S=2.0
# 1 only while a person is at the robot during bring-up. Enables spider-robotctl bench.
SG_BENCH=0
# Optional per-source caps (see spider_gateway/policy.py). Remote may never exceed voice.
# SG_POLICY_FILE=/etc/spider/gateway-policy.yaml
# Where the gateway keeps the runtime moves switch; systemd creates this directory.
# SG_STATE_DIR=/var/lib/spider-gateway
# Used only by spider-robotctl, the SSH fallback console:
SC_USERNAME=spider-console
SC_PASSWORD_FILE=/etc/spider/secrets/spider-console.mqtt
# Used only by spider-button, the physical E-stop release:
SB_MQTT_USERNAME=spider-button
SB_MQTT_PASSWORD_FILE=/etc/spider/secrets/spider-button.mqtt
SB_BUTTON_CHIP=/dev/gpiochip0
SB_BUTTON_LINE=27
