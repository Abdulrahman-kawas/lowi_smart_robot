[Unit]
Description=Liquid LFM2.5-1.2B planner and question answering (llama-server, loopback, port 8080)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
Environment=LLAMA_CACHE=/var/lib/liquid
ExecStart=/usr/local/bin/llama-server -hf LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q4_K_M \
  --host 127.0.0.1 --port 8080 -c 8192 --jinja -t 6 --parallel 1
Restart=on-failure
RestartSec=5
Nice=10
MemoryHigh=2G
MemoryMax=2500M
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
