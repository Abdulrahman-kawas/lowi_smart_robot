# /etc/spider-brain/brain.env (mode 600). Secrets go in /etc/spider-brain/secrets.env.
SB_ROBOT_ID=spider-01
SB_ROBOT_SOURCE=planner
SB_HUMAN_SOURCE=remote
SB_MQTT_HOST=REPLACE_WITH_PI_TAILSCALE_NAME
SB_MQTT_PORT=8883
SB_MQTT_TLS=true
SB_MQTT_CA_PATH=/etc/spider-brain/certs/ca.crt
SB_MQTT_CERT_PATH=/etc/spider-brain/certs/spider-brain.crt
SB_MQTT_KEY_PATH=/etc/spider-brain/certs/spider-brain.key

SB_AUTONOMY=guarded
SB_WALK_SPEED_SLOW=0.03
SB_WALK_SPEED_NORMAL=0.06
SB_LIQUID_URL=http://127.0.0.1:8080/v1
SB_VISION_URL=http://127.0.0.1:8081/v1
SB_VISION_TIMEOUT_S=40

SB_ASK_WORKER=true
SB_ASK_ROUTE=liquid
SB_STT_WORKER=true
SB_STT_MODEL=small
SB_STT_THREADS=6
SB_MEMORY_PATH=/var/lib/spider-brain/memory.jsonl
SB_TRACES_PATH=/var/lib/spider-brain/voice_traces.jsonl
SB_TELEGRAM_OWNER_IDS=[REPLACE_WITH_TELEGRAM_USER_ID]

# Mobile app API at /v1 on the dashboard port (8765), loopback only. Publish that port once with
# `sudo tailscale serve --bg 8765`. Pair a phone with `spider-brain pair`; list or revoke phones
# with `spider-brain devices list` and `spider-brain devices revoke <name>`.
# SB_MOBILE=true
# SB_MOBILE_DATA_DIR=/var/lib/spider-brain/mobile

# Cloud escalation is off until these are set. NIM: kimi-k3 has a hosted endpoint; check before
# switching to kimi-k3.1-pro, whose page said on 2026-11-04 that API access was not available.
# SB_ASK_FALLBACK=compat:moonshotai/kimi-k3
# SB_VISION_FALLBACK=compat:moonshotai/kimi-k3
# SB_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1

# Recording and mapping. AWS stays off while SB_AWS_WORKER_INSTANCE_ID is empty.
SB_PI_SSH_TARGET=REPLACE_WITH_SPIDER_AT_PI_TAILSCALE_NAME
SB_RECORDINGS_DIR=/var/lib/spider-brain/recordings
SB_AWS_WORKER_INSTANCE_ID=
SB_AWS_WORKER_SSH_TARGET=
