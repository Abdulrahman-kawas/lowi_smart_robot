# /etc/systemd/system/ollama.service. Replaces the unit the installer writes, whose
# After=network-online.target a drop-in cannot remove. Local voice must work with no network.
[Unit]
Description=Ollama for the spider robot router (loopback only)
After=local-fs.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_KEEP_ALIVE=-1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
CPUAffinity=1 2 3
Nice=5
MemoryHigh=800M
MemoryMax=1G
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
