{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAndStopOnlyTheWorker",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:ap-northeast-1:REPLACE_WITH_ACCOUNT_ID:instance/REPLACE_WITH_INSTANCE_ID"
    },
    {
      "Sid": "DescribeCannotBeScopedToAnInstance",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances"],
      "Resource": "*"
    }
  ]
}
