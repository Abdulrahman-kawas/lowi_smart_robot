          }
        }
      }
    },
    "Forgets the token on this device. To cut it off on the server as well, run `spider-brain devices revoke \"%@\"`.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのトークンを削除します。サーバー側でも無効にするには `spider-brain devices revoke \"%@\"` を実行してください。"
          }
        }
      }
    },
    "Haptics": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触覚フィードバック"
          }
